@model CraftIQ.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div style="max-width:600px; margin:4rem auto; padding:2rem; font-family:'JetBrains Mono',monospace;">
    <h2 style="color:#ff4757; margin-bottom:1rem;">Something went wrong.</h2>
    <p style="color:#64748b;">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p style="margin-top:1rem; color:#64748b;">
            Request ID: <strong style="color:#e2e8f0;">@Model.RequestId</strong>
        </p>
    }
    <a href="/" style="display:inline-block; margin-top:2rem; color:#00d4ff;">← Go back home</a>
</div>