@model CraftIQ.Models.HistoryViewModel
@{
    ViewData["Title"] = "History";
    ViewData["Page"]  = "history";
}

<style>
    .hist-header { margin-bottom: 1.75rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); }
    .hist-title  { font-size: 1.2rem; font-weight: 700; color: var(--dark); letter-spacing: -.02em; margin-bottom: .25rem; }
    .hist-sub    { font-size: .82rem; color: var(--muted); }

    .hist-section-label {
        font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
        color: var(--muted); margin: 1.75rem 0 .75rem; display: flex; align-items: center; gap: .5rem;
    }
    .hist-section-label::after { content: ""; flex: 1; height: 1px; background: var(--border); }

    .hist-table {
        width: 100%; border-collapse: collapse; background: #fff;
        border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    }
    .hist-table th {
        text-align: left; font-size: .68rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .08em; color: var(--muted); padding: .75rem 1rem;
        border-bottom: 1px solid var(--border); background: var(--surface);
    }
    .hist-table td {
        padding: .7rem 1rem; font-size: .82rem; color: var(--dark);
        border-bottom: 1px solid var(--border); vertical-align: middle;
    }
    .hist-table tr:last-child td { border-bottom: none; }
    .hist-table tr:hover td { background: var(--surface); }

    .hist-status { display: inline-flex; align-items: center; gap: .3rem; font-size: .7rem; font-weight: 600; padding: .18rem .6rem; border-radius: 100px; }
    .hist-status.complete { background: #dcfce7; color: #15803d; }
    .hist-status.draft    { background: #f1f5f9; color: var(--muted); }
    .hist-status.report   { background: #eff6ff; color: #1d4ed8; }

    .hist-score {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 50%; font-size: .76rem; font-weight: 700;
    }
    .hist-score.good { background: #dcfce7; color: #15803d; }
    .hist-score.warn { background: #fef3c7; color: #d97706; }
    .hist-score.bad  { background: #fef2f2; color: #dc2626; }

    /* Action buttons */
    .hist-actions { display: flex; align-items: center; gap: .4rem; justify-content: flex-end; }
    .hist-btn {
        font-size: .74rem; font-weight: 500; padding: .24rem .65rem;
        border-radius: 5px; cursor: pointer; font-family: var(--sans);
        white-space: nowrap; transition: background .12s; border: 1px solid transparent;
        text-decoration: none; display: inline-flex; align-items: center; gap: .3rem;
    }
    .hist-btn-open {
        color: var(--accent); border-color: #C7D2FE; background: #fff;
    }
    .hist-btn-open:hover { background: var(--accent-light); color: var(--accent); }
    .hist-btn-del {
        color: var(--muted); border-color: var(--border); background: #fff;
    }
    .hist-btn-del:hover { color: var(--red); border-color: #fecaca; background: #fef2f2; }

    /* Empty state */
    .hist-empty { padding: 2.5rem 1rem; text-align: center; color: var(--muted); font-size: .85rem; line-height: 1.7; }
    .hist-empty a { color: var(--accent); font-weight: 500; text-decoration: none; }

    /* Report viewer modal */
    .hist-modal-overlay {
        display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45);
        z-index: 2000; align-items: center; justify-content: center; padding: 1rem;
    }
    .hist-modal-overlay.open { display: flex; }
    .hist-modal-box {
        background: #fff; border-radius: 12px; max-width: 720px; width: 100%;
        max-height: 85vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.22);
    }
    .hist-modal-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1rem 1.25rem .85rem; border-bottom: 1px solid var(--border);
        position: sticky; top: 0; background: #fff; z-index: 1; border-radius: 12px 12px 0 0;
    }
    .hist-modal-title { font-size: .95rem; font-weight: 700; color: var(--dark); }
    .hist-modal-meta  { font-size: .72rem; color: var(--muted); font-family: var(--mono); margin-top: .15rem; }
    .hist-modal-close {
        width: 30px; height: 30px; border: none; background: none; cursor: pointer;
        border-radius: 6px; font-size: .9rem; color: var(--muted); flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .hist-modal-close:hover { background: var(--surface); color: var(--dark); }
    .hist-modal-body { padding: 1.25rem 1.4rem 1.6rem; font-size: .88rem; }
    .hist-modal-loading { padding: 3rem; text-align: center; color: var(--muted); font-family: var(--mono); font-size: .82rem; }

    /* Shared CIC display styles needed for report rendering */
    .cic-sub-label { font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#b08d57;font-family:monospace;margin:.75rem 0 .38rem; }
    .cic-sub-label:first-child { margin-top:0; }
    .cic-tag { display:inline-flex;align-items:center;padding:3px 11px;border-radius:100px;font-size:.76rem;font-weight:600;margin:2px; }
    .cic-tag.red   { background:#fef2f2;color:#dc2626;border:1px solid #fecaca; }
    .cic-tag.green { background:#dcfce7;color:#15803d;border:1px solid #86efac; }
    .cic-tag.amber { background:#fffbeb;color:#92400e;border:1px solid #fde68a; }
    .cic-tag.blue  { background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe; }
    .cic-item { display:flex;align-items:flex-start;gap:.45rem;margin-bottom:.35rem;font-size:.86rem;line-height:1.55; }
    .cic-item-ic { flex-shrink:0;margin-top:.15rem;font-size:.78rem; }
</style>

<div class="hist-header">
    <div class="hist-title">History</div>
    <div class="hist-sub">Your saved documents and analysis reports</div>
</div>

<!-- ── CV / Cover Letter Documents ── -->
<div class="hist-section-label">CV &amp; Cover Letter Documents</div>

@if (!Model.Documents.Any())
{
    <div class="hist-empty">
        No saved documents yet.<br>
        <a href="/Home/CVBuilder">Build your first CV &rarr;</a>
    </div>
}
else
{
    <table class="hist-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Last updated</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Documents)
            {
                <tr id="doc-row-@item.Id">
                    <td style="font-weight:500;">@item.Title</td>
                    <td><span class="hist-status @item.Status">@(item.Status == "complete" ? "Complete" : "Draft")</span></td>
                    <td style="color:var(--muted);font-family:var(--mono);font-size:.75rem;">@item.RelativeTime</td>
                    <td>
                        <div class="hist-actions">
                            <a href="@item.ReopenUrl" class="hist-btn hist-btn-open">
                                &#128196; @(item.Status == "complete" ? "Open" : "Continue")
                            </a>
                            <button class="hist-btn hist-btn-del"
                                    onclick="deleteDocument('@item.Id', this)"
                                    title="Delete document">
                                &#128465; Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ── Analysis Reports ── -->
<div class="hist-section-label">Analysis Reports</div>

@if (!Model.Reports.Any())
{
    <div class="hist-empty">
        No analysis reports yet.<br>
        Run an analysis in the <a href="/Home/CareerIntelligence">Career Intelligence Center</a> and click <strong>Save Report</strong>.
    </div>
}
else
{
    <table class="hist-table">
        <thead>
            <tr>
                <th>Report</th>
                <th>Type</th>
                <th>Score</th>
                <th>Date</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reports)
            {
                var scoreClass = r.OverallScore >= 80 ? "good" : r.OverallScore >= 60 ? "warn" : "bad";
                <tr id="report-row-@r.Id">
                    <td style="font-weight:500;">@r.Title</td>
                    <td>
                        <span class="hist-status report">@r.AnalysisType</span>
                        @if (!string.IsNullOrEmpty(r.DocumentType))
                        {
                            <span style="font-size:.7rem;color:var(--muted);margin-left:.3rem;">(@r.DocumentType)</span>
                        }
                    </td>
                    <td>
                        @if (r.OverallScore > 0)
                        {
                            <span class="hist-score @scoreClass">@r.OverallScore</span>
                        }
                        else
                        {
                            <span style="color:var(--muted);font-size:.8rem;">—</span>
                        }
                    </td>
                    <td style="color:var(--muted);font-family:var(--mono);font-size:.75rem;">@r.RelativeTime</td>
                    <td>
                        <div class="hist-actions">
                            <button class="hist-btn hist-btn-open"
                                    onclick="openReport('@r.Id', '@Html.Raw(r.Title.Replace("'","\\\'"))', '@r.AnalysisType', '@r.RelativeTime')">
                                &#128065; Open
                            </button>
                            <button class="hist-btn hist-btn-del"
                                    onclick="deleteReport('@r.Id', this)"
                                    title="Delete report">
                                &#128465; Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ── Report viewer modal ── -->
<div class="hist-modal-overlay" id="reportModal" onclick="closeReportModal(event)">
    <div class="hist-modal-box" onclick="event.stopPropagation()">
        <div class="hist-modal-head">
            <div>
                <div class="hist-modal-title" id="reportModalTitle"></div>
                <div class="hist-modal-meta" id="reportModalMeta"></div>
            </div>
            <button class="hist-modal-close" onclick="closeReportModalForce()" title="Close">&#10005;</button>
        </div>
        <div class="hist-modal-body" id="reportModalBody">
            <div class="hist-modal-loading">Loading&#8230;</div>
        </div>
    </div>
</div>

<script>
    // ── Open analysis report ──────────────────────────────────────
    function openReport(id, title, type, date) {
        var modal = document.getElementById("reportModal");
        var titleEl = document.getElementById("reportModalTitle");
        var metaEl  = document.getElementById("reportModalMeta");
        var bodyEl  = document.getElementById("reportModalBody");

        if (titleEl) titleEl.textContent = title;
        if (metaEl)  metaEl.textContent  = type + " · " + date;
        if (bodyEl)  bodyEl.innerHTML    = '<div class="hist-modal-loading">Loading&#8230;</div>';
        if (modal)   modal.classList.add("open");
        document.body.style.overflow = "hidden";

        fetch("/api/analysis-reports/" + id)
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (!d || !d.resultJson) {
                bodyEl.innerHTML = '<div style="color:var(--muted);font-size:.85rem;padding:1rem 0;">No content stored for this report.</div>';
                return;
            }
            // Strip the Save Report button from the stored HTML (it's in History context)
            var html = d.resultJson
                .replace(/<div style="margin-top:14px;padding-top:12px;border-top[^>]*>[\s\S]*?<\/div>/i, "")
                .replace(/<div[^>]*cic-save-btn[^>]*>[\s\S]*?<\/div>/i, "");
            bodyEl.innerHTML = html;
        })
        .catch(function(e) {
            if (bodyEl) bodyEl.innerHTML = '<div style="color:#dc2626;font-size:.85rem;">Failed to load report: ' + e.message + '</div>';
        });
    }

    function closeReportModal(evt) {
        if (evt && !evt.target.classList.contains("hist-modal-overlay")) return;
        closeReportModalForce();
    }

    function closeReportModalForce() {
        var modal = document.getElementById("reportModal");
        if (modal) modal.classList.remove("open");
        document.body.style.overflow = "";
    }

    // ── Delete analysis report ────────────────────────────────────
    function deleteReport(id, btn) {
        if (!confirm("Delete this analysis report? This cannot be undone.")) return;
        if (btn) btn.disabled = true;
        fetch("/api/analysis-reports/" + id, { method: "DELETE" })
        .then(function(r) {
            if (r.ok) {
                var row = document.getElementById("report-row-" + id);
                if (row) {
                    row.style.transition = "opacity .3s";
                    row.style.opacity = "0";
                    setTimeout(function() { row.remove(); }, 300);
                }
            } else {
                alert("Delete failed. Please try again.");
                if (btn) btn.disabled = false;
            }
        })
        .catch(function() {
            alert("Delete failed. Please try again.");
            if (btn) btn.disabled = false;
        });
    }

    // ── Delete CV document ────────────────────────────────────────
    function deleteDocument(id, btn) {
        if (!confirm("Delete this document? This cannot be undone.")) return;
        if (btn) btn.disabled = true;
        fetch("/api/cv-storage/" + id, { method: "DELETE" })
        .then(function(r) {
            if (r.ok) {
                var row = document.getElementById("doc-row-" + id);
                if (row) {
                    row.style.transition = "opacity .3s";
                    row.style.opacity = "0";
                    setTimeout(function() { row.remove(); }, 300);
                }
            } else {
                alert("Delete failed. Please try again.");
                if (btn) btn.disabled = false;
            }
        })
        .catch(function() {
            alert("Delete failed. Please try again.");
            if (btn) btn.disabled = false;
        });
    }
</script>
