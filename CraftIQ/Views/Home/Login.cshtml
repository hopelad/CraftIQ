@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — CraftIQ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --cream: #faf8f4;
            --warm-white: #fff9f5;
            --paper: #f5f0e8;
            --sand: #e8e0d0;
            --tan: #c8b89a;
            --brown: #8b6f47;
            --dark: #2c2416;
            --charcoal: #3d3228;
            --accent: #c17f3e;
            --accent-light: #f0e4d0;
            --muted: #7a6a58;
            --border: #e2d9cc;
            --border-dark: #c8b89a;
            --red: #c0392b;
            --serif: 'Playfair Display', Georgia, serif;
            --sans: 'DM Sans', system-ui, sans-serif;
            --mono: 'DM Mono', monospace;
        }

        html, body {
            min-height: 100vh;
            background: var(--cream);
            font-family: var(--sans);
            -webkit-font-smoothing: antialiased;
        }

        .login-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel ── */
        .login-left {
            background: var(--dark);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
        }

            .login-left::before {
                content: '';
                position: absolute;
                bottom: -80px;
                right: -80px;
                width: 320px;
                height: 320px;
                border-radius: 50%;
                background: rgba(193,127,62,.08);
            }

            .login-left::after {
                content: '';
                position: absolute;
                top: -60px;
                left: -60px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(193,127,62,.05);
            }

        .left-logo {
            display: flex;
            align-items: center;
            gap: .6rem;
            text-decoration: none;
            position: relative;
            z-index: 1;
        }

        .left-logo-mark {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--mono);
            font-size: .68rem;
            color: #fff;
        }

        .left-logo-text {
            font-family: var(--serif);
            font-weight: 700;
            font-size: 1.05rem;
            color: #fff;
        }

            .left-logo-text em {
                font-style: italic;
                color: var(--tan);
            }

        .left-content {
            position: relative;
            z-index: 1;
        }

        .left-title {
            font-family: var(--serif);
            font-weight: 700;
            font-size: 2rem;
            color: #fff;
            line-height: 1.25;
            margin-bottom: 1rem;
            letter-spacing: -.02em;
        }

            .left-title em {
                font-style: italic;
                color: var(--tan);
            }

        .left-desc {
            font-size: .875rem;
            color: rgba(255,255,255,.5);
            line-height: 1.7;
            margin-bottom: 2rem;
            max-width: 320px;
        }

        .left-features {
            display: flex;
            flex-direction: column;
            gap: .65rem;
        }

        .left-feat {
            display: flex;
            align-items: center;
            gap: .65rem;
            font-size: .83rem;
            color: rgba(255,255,255,.6);
        }

        .left-feat-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent);
            flex-shrink: 0;
        }

        .left-footer {
            position: relative;
            z-index: 1;
            font-size: .75rem;
            color: rgba(255,255,255,.25);
            font-family: var(--mono);
        }

        /* ── Right panel ── */
        .login-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2.5rem;
            background: var(--warm-white);
        }

        .login-form-wrap {
            width: 100%;
            max-width: 380px;
        }

        .login-heading {
            font-family: var(--serif);
            font-weight: 700;
            font-size: 1.9rem;
            color: var(--dark);
            margin-bottom: .4rem;
            letter-spacing: -.02em;
        }

        .login-sub {
            font-size: .875rem;
            color: var(--muted);
            margin-bottom: 2.25rem;
            line-height: 1.5;
        }

        .field {
            margin-bottom: 1.1rem;
        }

            .field label {
                display: block;
                font-size: .78rem;
                font-weight: 500;
                color: var(--charcoal);
                margin-bottom: .45rem;
                letter-spacing: .02em;
            }

        .field-input-wrap {
            position: relative;
        }

        .field-icon {
            position: absolute;
            left: .9rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--tan);
            font-size: .85rem;
        }

        .field input {
            width: 100%;
            padding: .75rem 1rem .75rem 2.4rem;
            background: var(--warm-white);
            border: 1.5px solid var(--border);
            border-radius: 9px;
            font-size: .875rem;
            color: var(--dark);
            font-family: var(--sans);
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .field input:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(193,127,62,.1);
                background: #fff;
            }

            .field input::placeholder {
                color: var(--tan);
            }

        .val-errors {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 9px;
            padding: .65rem .9rem;
            margin-bottom: 1.25rem;
            font-size: .8rem;
            color: var(--red);
        }

            .val-errors ul {
                list-style: none;
            }

            .val-errors li::before {
                content: '✕  ';
            }

        .login-btn {
            width: 100%;
            padding: .8rem;
            background: var(--dark);
            border: none;
            border-radius: 9px;
            color: var(--cream);
            font-family: var(--sans);
            font-size: .9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s;
            margin-top: .5rem;
            letter-spacing: .01em;
            box-shadow: 0 2px 10px rgba(44,36,22,.18);
        }

            .login-btn:hover {
                background: var(--charcoal);
                transform: translateY(-1px);
                box-shadow: 0 4px 16px rgba(44,36,22,.22);
            }

        .login-divider {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin: 1.4rem 0;
            font-size: .78rem;
            color: var(--tan);
        }

            .login-divider::before, .login-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .login-note {
            text-align: center;
            font-size: .78rem;
            color: var(--muted);
            font-family: var(--mono);
        }

            .login-note code {
                background: var(--accent-light);
                color: var(--accent);
                padding: .1em .35em;
                border-radius: 4px;
            }

        .login-footer-badges {
            display: flex;
            gap: 1.25rem;
            flex-wrap: wrap;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
        }

        .lfb {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .75rem;
            color: var(--muted);
        }

        .lfb-icon {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: var(--paper);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .75rem;
        }

        @@media (max-width: 768px) {
            .login-page {
                grid-template-columns: 1fr;
            }

            .login-left {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="login-page">
        <!-- Left -->
        <div class="login-left">
            <a class="left-logo" href="/">
                <div class="left-logo-mark">&lt;/&gt;</div>
                <span class="left-logo-text">Craft<em>IQ</em></span>
            </a>
            <div class="left-content">
                <h2 class="left-title">
                    Your AI workspace<br>for <em>code & career.</em>
                </h2>
                <p class="left-desc">
                    Refactor C/C++ code with precision, craft
                    professional CVs and cover letters — all
                    in one natural workspace.
                </p>
                <div class="left-features">
                    <div class="left-feat"><span class="left-feat-dot"></span> AI-driven C/C++ code refactoring</div>
                    <div class="left-feat"><span class="left-feat-dot"></span> Code smell detection & analysis</div>
                    <div class="left-feat"><span class="left-feat-dot"></span> Professional CV builder</div>
                    <div class="left-feat"><span class="left-feat-dot"></span> Smart cover letter generator</div>
                </div>
            </div>
            <div class="left-footer">CraftIQ © 2025</div>
        </div>

        <!-- Right -->
        <div class="login-right">
            <div class="login-form-wrap">
                <h1 class="login-heading">Welcome back.</h1>
                <p class="login-sub">Sign in to continue to your workspace.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="val-errors">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" asp-action="Login" asp-controller="Home">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label for="username">Username</label>
                        <div class="field-input-wrap">
                            <span class="field-icon">✉</span>
                            <input type="text" id="username" name="username"
                                   placeholder="Enter your username"
                                   autocomplete="username" required />
                        </div>
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <div class="field-input-wrap">
                            <span class="field-icon">🔒</span>
                            <input type="password" id="password" name="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" required />
                        </div>
                    </div>
                    <button type="submit" class="login-btn">Sign in →</button>
                </form>

                <div class="login-divider">or</div>
                <div class="login-note">
                    Demo: any username + password <code>≥ 6 chars</code>
                </div>

                <div class="login-footer-badges">
                    <div class="lfb"><div class="lfb-icon">🛡</div> Secure & private</div>
                    <div class="lfb"><div class="lfb-icon">⚡</div> Fast & intelligent</div>
                    <div class="lfb"><div class="lfb-icon">⭐</div> Trusted by devs</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>