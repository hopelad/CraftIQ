            <div class="fmt-group">
                <button class="fmt-btn" id="fmtAlignL" data-align="Left"   title="Align Left (Ctrl+L)">
                    <svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor">
                        <rect x="0" y="0"  width="15" height="2" rx="1"/><rect x="0" y="4"  width="10" height="2" rx="1"/>
                        <rect x="0" y="8"  width="15" height="2" rx="1"/><rect x="0" y="11" width="7"  height="2" rx="1"/>
                    </svg>
                </button>
                <button class="fmt-btn" id="fmtAlignC" data-align="Center" title="Center (Ctrl+E)">
                    <svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor">
                        <rect x="0"   y="0"  width="15" height="2" rx="1"/><rect x="2.5" y="4"  width="10" height="2" rx="1"/>
                        <rect x="0"   y="8"  width="15" height="2" rx="1"/><rect x="4"   y="11" width="7"  height="2" rx="1"/>
                    </svg>
                </button>
                <button class="fmt-btn" id="fmtAlignR" data-align="Right"  title="Align Right (Ctrl+R)">
                    <svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor">
                        <rect x="0" y="0"  width="15" height="2" rx="1"/><rect x="5"   y="4"  width="10" height="2" rx="1"/>
                        <rect x="0" y="8"  width="15" height="2" rx="1"/><rect x="8"   y="11" width="7"  height="2" rx="1"/>
                    </svg>
                </button>
                <button class="fmt-btn" id="fmtAlignJ" data-align="Full"   title="Justify (Ctrl+J)">
                    <svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor">
                        <rect x="0" y="0"  width="15" height="2" rx="1"/><rect x="0" y="4"  width="15" height="2" rx="1"/>
                        <rect x="0" y="8"  width="15" height="2" rx="1"/><rect x="0" y="11" width="15" height="2" rx="1"/>
                    </svg>
                </button>
            </div>

            <div class="fmt-sep"></div>

            <!-- Group 5: Lists + Indent -->
            <div class="fmt-group">
                <button class="fmt-btn" id="fmtUL"      title="Bullet List" data-cmd="insertUnorderedList">
                    <svg width="16" height="13" viewBox="0 0 16 13" fill="currentColor">
                        <circle cx="1.4" cy="1.5" r="1.4"/><rect x="5" y="0" width="11" height="2" rx="1"/>
                        <circle cx="1.4" cy="6.5" r="1.4"/><rect x="5" y="5" width="11" height="2" rx="1"/>
                        <circle cx="1.4" cy="11.5" r="1.4"/><rect x="5" y="10" width="11" height="2" rx="1"/>
                    </svg>
                </button>
                <button class="fmt-btn" id="fmtOL"      title="Numbered List" data-cmd="insertOrderedList">
                    <svg width="16" height="13" viewBox="0 0 16 13" fill="currentColor">
                        <text x="0" y="3"  font-size="4.5" font-weight="bold" font-family="Arial">1.</text>
                        <rect x="5" y="0"  width="11" height="2" rx="1"/>
                        <text x="0" y="8"  font-size="4.5" font-weight="bold" font-family="Arial">2.</text>
                        <rect x="5" y="5"  width="11" height="2" rx="1"/>
                        <text x="0" y="13" font-size="4.5" font-weight="bold" font-family="Arial">3.</text>
                        <rect x="5" y="10" width="11" height="2" rx="1"/>
                    </svg>
                </button>
                <button class="fmt-btn" id="fmtIndent"  title="Increase Indent" data-cmd="indent">
                    <svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor">
                        <rect x="0" y="0" width="15" height="2" rx="1"/>
                        <polygon points="0,5 5,7 0,9"/>
                        <rect x="6" y="5"  width="9" height="2" rx="1"/>
                        <rect x="0" y="11" width="15" height="2" rx="1"/>
                    </svg>
                </button>
                <button class="fmt-btn" id="fmtOutdent" title="Decrease Indent" data-cmd="outdent">
                    <svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor">
                        <rect x="0" y="0" width="15" height="2" rx="1"/>
                        <polygon points="5,5 0,7 5,9"/>
                        <rect x="6" y="5"  width="9" height="2" rx="1"/>
                        <rect x="0" y="11" width="15" height="2" rx="1"/>
                    </svg>
                </button>
            </div>

            <div class="fmt-sep"></div>

            <!-- Group 6: Line spacing -->
            <div class="fmt-group" title="Line Spacing">
                <select class="fmt-sel-small" id="lineSpacingSel" title="Line spacing">
                    <option value="1.2">1.2&#215;</option>
                    <option value="1.5" selected>1.5&#215;</option>
                    <option value="1.75">1.75&#215;</option>
                    <option value="2.0">2.0&#215;</option>
                </select>
            </div>

            <div class="fmt-sep"></div>

            <!-- Group 7: Insert -->
            <div class="fmt-group">
                <button class="fmt-btn fmt-btn-wide" onclick="addTextBox()" title="Add a draggable text box anywhere on the CV"
                        style="gap:.28rem;white-space:nowrap;">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="currentColor">
                        <rect x="0" y="0" width="13" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.2"/>
                        <rect x="3" y="5.5" width="7" height="1.2" rx=".6"/>
                        <rect x="5.9" y="3" width="1.2" height="7" rx=".6"/>
                    </svg>
                    Text Box
                </button>
            </div>

        </div><!-- end fmt-toolbar -->

        <!-- ═══ CV PREVIEW ═══ -->
        <div class="preview-area-wrap" id="previewAreaWrap">
            <div class="preview-paper"
                 id="cvPreviewArea"
                 contenteditable="true"
                 spellcheck="false">
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:500px;gap:14px;text-align:center;">
                    <div style="font-size:3rem;">&#128196;</div>
                    <div style="font-weight:600;font-size:1rem;color:var(--dark);">Loading your CV&#8230;</div>
                </div>
            </div>
        </div>

        <!-- ═══ COVER LETTER PREVIEW ═══ -->
        <div class="preview-area-wrap" id="clPreviewWrap" style="display:none;">
            <div class="cl-preview-paper"
                 id="clPreviewArea"
                 contenteditable="false"
                 spellcheck="true">
                <div id="clPlaceholder" style="display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-height:540px;padding:0 8px;">

                    <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-family:var(--mono);margin-bottom:1rem;">How it works</div>

                    <div style="display:flex;flex-direction:column;gap:1.1rem;max-width:380px;">

                        <div style="display:flex;gap:.9rem;align-items:flex-start;">
                            <div style="width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">1</div>
                            <div>
                                <div style="font-size:.84rem;font-weight:600;color:var(--dark);margin-bottom:.18rem;">Select a letter style</div>
                                <div style="font-size:.76rem;color:var(--muted);line-height:1.55;">Pick from Classic, Modern, Minimal, Executive, or any of the 8 styles in the left panel under <strong>Letter Style</strong>.</div>
                            </div>
                        </div>

                        <div style="display:flex;gap:.9rem;align-items:flex-start;">
                            <div style="width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">2</div>
                            <div>
                                <div style="font-size:.84rem;font-weight:600;color:var(--dark);margin-bottom:.18rem;">Fill in the Generate panel</div>
                                <div style="font-size:.76rem;color:var(--muted);line-height:1.55;">Enter the <strong>Company name</strong> and paste the <strong>Job Description</strong>. The rest (your name, role, skills) is auto-filled from your CV.</div>
                            </div>
                        </div>

                        <div style="display:flex;gap:.9rem;align-items:flex-start;">
                            <div style="width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">3</div>
                            <div>
                                <div style="font-size:.84rem;font-weight:600;color:var(--dark);margin-bottom:.18rem;">Choose tone and focus areas</div>
                                <div style="font-size:.76rem;color:var(--muted);line-height:1.55;">Pick a tone (Professional, Confident, Direct…) and select focus areas like Technical, Projects, or Leadership.</div>
                            </div>
                        </div>

                        <div style="display:flex;gap:.9rem;align-items:flex-start;">
                            <div style="width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">4</div>
                            <div>
                                <div style="font-size:.84rem;font-weight:600;color:var(--dark);margin-bottom:.18rem;">Click Generate Cover Letter</div>
                                <div style="font-size:.76rem;color:var(--muted);line-height:1.55;">Your letter appears here. <strong>Click anywhere in the letter to edit it directly</strong> — just like a word processor. Use the toolbar above for formatting.</div>
                            </div>
                        </div>

                        <div style="display:flex;gap:.9rem;align-items:flex-start;">
                            <div style="width:24px;height:24px;border-radius:50%;background:var(--green);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">5</div>
                            <div>
                                <div style="font-size:.84rem;font-weight:600;color:var(--dark);margin-bottom:.18rem;">Save · Download · Copy</div>
                                <div style="font-size:.76rem;color:var(--muted);line-height:1.55;">Use the buttons below to download as PDF or DOCX, or copy the full text to clipboard.</div>
                            </div>
                        </div>

                    </div>

                    <div style="margin-top:1.75rem;padding:.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;font-size:.76rem;color:var(--muted);line-height:1.6;max-width:380px;">
                        <strong style="color:var(--dark);">Tip:</strong> Paste the full job description for the best results — the AI extracts keywords and matches them to your CV automatically.
                    </div>

                </div>
            </div>
        </div>

        <!-- ═══ CV ACTION BAR ═══ -->
        <div class="tmpl-action-bar" id="cvActionBar">
            <button class="btn-a btn-save" id="saveBtn" onclick="saveCV()">
                &#128190; Save
            </button>
            <button class="btn-a btn-pdf" id="dlPdfBtn" onclick="dlPdf()">
                &#128196; PDF
            </button>
            <button class="btn-a btn-docx" id="dlDocxBtn" onclick="dlDocx()">
                &#127381; DOCX
            </button>
            <button class="btn-a btn-png" id="dlPngBtn" onclick="dlPng()">
                &#128247; PNG
            </button>
            <a href="/Home/CVBuilder?id=@cvRecordId" class="btn-a btn-edit">
                &#9998; Edit Form
            </a>
        </div>

        <!-- ═══ COVER LETTER ACTION BAR ═══ -->
        <div class="tmpl-action-bar" id="clActionBar" style="display:none;">
            <button class="btn-a btn-save" id="clSaveBtn" onclick="saveCL()">
                &#128190; Save
            </button>
            <button class="btn-a btn-pdf" id="clPdfBtn" onclick="dlCLPdf()">
                &#128196; PDF
            </button>
            <button class="btn-a btn-docx" id="clDocxBtn" onclick="dlCLDocx()">
                &#127381; DOCX
            </button>
            <button class="btn-a btn-png" id="clPngBtn" onclick="dlCLPng()">
                &#128247; PNG
            </button>
            <button class="btn-a btn-back" id="clCopyBtn" onclick="clCopyText()" style="margin-left:auto;">
                &#128203; Copy
            </button>
        </div>

    </div>

</div>

<!-- ═══════════════════════════════════════════════════════════════
     CAREER INTELLIGENCE CENTER
     Appears after the user selects a template for the first time.
════════════════════════════════════════════════════════════════ -->
<div class="cic-wrap" id="cicSection" style="display:none;">

    <!-- Header -->
    <div class="cic-toprow">
        <div>
            <div class="cic-title">Career Intelligence Center</div>
            <div class="cic-sub" id="cicSubtitle">AI-powered tools to finalize and optimize your career documents</div>
        </div>
        <div class="cic-header-scores">
            <div class="cic-score-pill" id="cic-score-ats">
                <span class="sp-label">ATS</span>
                <span class="sp-value" id="cic-val-ats">—</span>
            </div>
            <div class="cic-score-pill" id="cic-score-job">
                <span class="sp-label">Job Match</span>
                <span class="sp-value" id="cic-val-job">—</span>
            </div>
            <div class="cic-score-pill" id="cic-score-health">
                <span class="sp-label">Health</span>
                <span class="sp-value" id="cic-val-health">—</span>
            </div>
        </div>
    </div>

    <!-- Job Description Panel -->
    <div class="cic-jd-panel">
        <div class="cic-jd-toggle" onclick="cicToggleJdPanel()">
            <span class="cic-jd-toggle-label">
                &#128196; Job Description
                <span class="cic-jd-required-badge">Required for ATS &amp; Job Match</span>
            </span>
            <span id="cicJdArrow" style="font-size:.72rem;color:var(--muted);">&#9660;</span>
        </div>
        <div class="cic-jd-body" id="cicJdBody">
            <div class="cic-jd-row">
                <div class="cic-jd-field">
                    <label>Job Title *</label>
                    <input type="text" id="cicJdTitle" placeholder="e.g. Software Engineer"
                           oninput="cicOnJdChange()" />
                </div>
                <div class="cic-jd-field">
                    <label>Company (optional)</label>
                    <input type="text" id="cicJdCompany" placeholder="e.g. Google" />
                </div>
            </div>
            <div class="cic-jd-field">
                <label>Job Description * (paste full posting for accurate analysis)</label>
                <textarea id="cicJdText" rows="4" placeholder="Paste the full job description here…"
                          oninput="cicOnJdChange()"></textarea>
            </div>
            <div class="cic-jd-warning" id="cicJdWarning">
                &#9888; ATS Analysis and Job Match Analysis require a Job Description.
                Without it, only general feedback is available.
            </div>
            <div style="margin-top:.5rem;">
                <button class="cic-jd-set-btn" onclick="cicJdConfirm()">&#10003; Apply Job Description</button>
                <span id="cicJdConfirmed" style="font-size:.72rem;color:var(--green);font-family:var(--mono);margin-left:.6rem;display:none;">Applied &#10003;</span>
            </div>
        </div>
    </div>

    <!-- OCR Extracted Text Review Panel (shown after image upload) -->
    <div class="cic-ocr-panel" id="cicOcrPanel">
        <div class="cic-ocr-label">
            &#128247; Extracted text — review and edit before analysis
        </div>
        <textarea class="cic-ocr-textarea" id="cicOcrTextarea" placeholder="Extracted text will appear here…"></textarea>
        <div class="cic-ocr-actions">
            <button class="cic-ocr-use-btn" onclick="cicApplyOcrText()">Use for Analysis</button>
            <button class="cic-ocr-discard-btn" onclick="cicDiscardOcr()">Discard</button>
            <span class="cic-ocr-warning" id="cicOcrWarning">&#9888; OCR confidence may be low — review carefully</span>
        </div>
    </div>

    <!-- Source switcher + upload -->
    <div class="cic-source-bar">
        <div class="cic-src-sw">
            <button class="cic-src-btn active" id="cicSrcCurrentBtn" onclick="cicSetSource('current')">
                &#128196; Current Document
            </button>
            <button class="cic-src-btn" id="cicSrcUploadBtn" onclick="cicSetSource('uploaded')">
                &#128228; Uploaded Document
            </button>
        </div>
        <div class="cic-upload-zone" id="cicUploadZone" style="display:none;">
            <label class="cic-upload-label">
                <input type="file" id="cicFileInput" accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.webp" onchange="cicHandleUpload(this)" />
                &#128206; Choose PDF, DOCX, or TXT
            </label>
            <span class="cic-upload-status" id="cicUploadStatus">No file selected</span>
        </div>
        <span class="cic-src-badge current" id="cicSrcBadge">Analyzing: Current CV</span>
    </div>

    <!-- Progress indicator -->
    <div class="ciq-progress" style="margin-bottom:1.25rem;">
        <div class="ciq-step done">
            <div class="ciq-dot"></div>
            <span class="ciq-step-label">CV Created</span>
        </div>
        <div class="ciq-line"></div>
        <div class="ciq-step done">
            <div class="ciq-dot"></div>
            <span class="ciq-step-label">Template Selected</span>
        </div>
        <div class="ciq-line"></div>
        <div class="ciq-step" id="cic-step-analysis">
            <div class="ciq-dot"></div>
            <span class="ciq-step-label">Analysis Complete</span>
        </div>
        <div class="ciq-line"></div>
        <div class="ciq-step" id="cic-step-export">
            <div class="ciq-dot"></div>
            <span class="ciq-step-label">Export Ready</span>
        </div>
    </div>

    <!-- Cards grid -->
    <div class="cic-grid">

        <!-- 1. ATS Analysis -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#fef2f2;">&#127919;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">ATS Analysis</div>
                    <div class="cic-card-desc">Score · Keywords · Optimization suggestions</div>
                </div>
                <span class="cic-card-score" id="cic-s-ats">—</span>
                <button class="cic-run-btn" id="cic-btn-ats" onclick="cicRun('ats')">Analyze</button>
            </div>
            <div class="cic-card-body" id="cic-body-ats" style="display:none;"></div>
        </div>

        <!-- 2. Job Match Analysis -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#eff6ff;">&#128269;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">Job Match Analysis</div>
                    <div class="cic-card-desc">Match % · Missing skills · Required technologies</div>
                </div>
                <span class="cic-card-score" id="cic-s-job">—</span>
                <button class="cic-run-btn" id="cic-btn-job" onclick="cicRun('job')">Analyze</button>
            </div>
            <div class="cic-card-body" id="cic-body-job" style="display:none;">
                <div class="cic-sub-label">Job Description</div>
                <textarea id="cic-jobdesc" class="cic-input" rows="3"
                    style="resize:vertical;line-height:1.5;"
                    placeholder="Paste the job description for a tailored match analysis…"></textarea>
                <button class="cic-run-btn" style="margin-top:.6rem;" onclick="cicRunJobMatch()">Run Match Analysis</button>
                <div id="cic-body-job-result" style="margin-top:.75rem;"></div>
            </div>
        </div>

        <!-- 3. CV Health Report -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#f0fdf4;">&#9989;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">CV Health Report</div>
                    <div class="cic-card-desc">Completeness · Readability · Bullet quality</div>
                </div>
                <span class="cic-card-score" id="cic-s-health">—</span>
                <button class="cic-run-btn" id="cic-btn-health" onclick="cicRun('health')">Analyze</button>
            </div>
            <div class="cic-card-body" id="cic-body-health" style="display:none;"></div>
        </div>

        <!-- 4. Recruiter Review -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#faf5ff;">&#128101;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">Recruiter Review</div>
                    <div class="cic-card-desc">Strengths · Weaknesses · Hiring probability</div>
                </div>
                <span class="cic-card-score" id="cic-s-rec">—</span>
                <button class="cic-run-btn" id="cic-btn-rec" onclick="cicRun('recruiter')">Analyze</button>
            </div>
            <div class="cic-card-body" id="cic-body-rec" style="display:none;"></div>
        </div>

        <!-- 5. Interview Preparation -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#f0fdf4;">&#127908;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">Interview Preparation</div>
                    <div class="cic-card-desc">Technical · Behavioral · Project questions</div>
                </div>
                <span class="cic-card-score" id="cic-s-iq"></span>
                <button class="cic-run-btn" id="cic-btn-iq" onclick="cicRun('interview')">Generate</button>
            </div>
            <div class="cic-card-body" id="cic-body-iq" style="display:none;"></div>
        </div>

        <!-- 6. LinkedIn Generator -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#eff6ff;">&#128279;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">LinkedIn Generator</div>
                    <div class="cic-card-desc">Headline · About section · Experience rewrite</div>
                </div>
                <span class="cic-card-score" id="cic-s-li"></span>
                <button class="cic-run-btn" id="cic-btn-li" onclick="cicRun('linkedin')">Generate</button>
            </div>
            <div class="cic-card-body" id="cic-body-li" style="display:none;"></div>
        </div>

        <!-- 7. Cover Letter Review -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#F5F3FF;">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <rect x="1.5" y="1.5" width="13" height="13" rx="2" stroke="#5E6AD2" stroke-width="1.3"/>
                        <path d="M4 5.5h8M4 8h6M4 10.5h4" stroke="#5E6AD2" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="cic-card-info">
                    <div class="cic-card-name">Cover Letter Review</div>
                    <div class="cic-card-desc">Tone · Keywords · Clarity · Improvements</div>
                </div>
                <span class="cic-card-score" id="cic-s-cl-review">—</span>
                <button class="cic-run-btn" id="cic-btn-cl-review" onclick="cicReviewCoverLetter()">Review</button>
            </div>
            <div class="cic-card-body" id="cic-body-cl-review" style="display:none;"></div>
        </div>

        <!-- 8. Resume Optimizer -->
        <div class="cic-card">
            <div class="cic-card-head">
                <div class="cic-card-icon" style="background:#fefce8;">&#10024;</div>
                <div class="cic-card-info">
                    <div class="cic-card-name">Resume Optimizer</div>
                    <div class="cic-card-desc">Improve summary · Experience · Bullet impact</div>
                </div>
                <span class="cic-card-score" id="cic-s-opt"></span>
                <button class="cic-run-btn" id="cic-btn-opt" onclick="cicRun('optimizer')">Optimize</button>
            </div>
            <div class="cic-card-body" id="cic-body-opt" style="display:none;"></div>
        </div>

    </div><!-- /cic-grid -->
</div><!-- /cicSection -->

<!-- ── CIC Result Modal ── -->
<div id="cicModal" class="cic-modal-overlay" onclick="cicCloseModal(event)">
    <div class="cic-modal-box" onclick="event.stopPropagation()">
        <div class="cic-modal-header">
            <span class="cic-modal-title" id="cicModalTitle"></span>
            <button class="cic-modal-close" onclick="cicForceClose()" title="Close">&#10005;</button>
        </div>
        <div class="cic-modal-body" id="cicModalBody"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" crossorigin="anonymous"></script>
    <script src="~/js/cv-templates.js" asp-append-version="true"></script>
    <script src="~/js/cl-workspace.js" asp-append-version="true"></script>
    <script src="~/js/career-intelligence.js" asp-append-version="true"></script>
    <script>
        _cvRecordId = "@cvRecordId";

        document.addEventListener("DOMContentLoaded", function () {

            // Quick edit toggle
            var qh = document.getElementById("qeToggle");
            var qb = document.getElementById("qeBody");
            var qa = document.getElementById("qeArrow");
            if (qh && qb) {
                qh.addEventListener("click", function () {
                    var open = qb.style.display !== "none";
                    qb.style.display = open ? "none" : "block";
                    if (qa) qa.style.transform = open ? "rotate(-90deg)" : "rotate(0deg)";
                });
            }

            // Hook template selection → reveal Career Intelligence Center
            var _origSelect = window.selectTemplate;
            window.selectTemplate = function (id) {
                if (_origSelect) _origSelect(id);
                initCIC();
            };
        });
    </script>
}
