@{
    ViewData["Title"] = "Choose Template";
    ViewData["Page"] = "cvbuilder";
    var cvRecordId = ViewData["CVRecordId"]?.ToString() ?? "";
}

<style>
    /* ── Page shell ── */
    .tmpl-shell {
        display: grid;
        grid-template-columns: 252px 1fr;
        grid-template-rows: auto 1fr;
        gap: 0;
        height: calc(100vh - 56px);
        margin: -2rem -2rem 0;
        overflow: hidden;
    }

    /* ── Top bar ── */
    .tmpl-topbar {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .6rem 1.1rem;
        gap: 1rem;
        background: var(--warm-white);
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
    }

    .tmpl-topbar-left { display:flex; align-items:center; gap:.7rem; }
    .tmpl-topbar-title { font-family:var(--serif); font-weight:700; font-size:.95rem; color:var(--dark); }
    .tmpl-topbar-sub { font-size:.7rem; color:var(--muted); }

    .active-tmpl-badge {
        background:var(--accent-light); color:var(--accent);
        font-size:.7rem; font-weight:700; font-family:var(--mono);
        padding:.18rem .55rem; border-radius:100px; border:1px solid var(--accent);
    }

    /* ── Left panel ── */
    .tmpl-left {
        border-right:1px solid var(--border); background:var(--paper);
        overflow-y:auto; display:flex; flex-direction:column;
    }

    .tmpl-list-head {
        padding:.65rem 1rem; border-bottom:1px solid var(--border);
        font-family:var(--mono); font-size:.67rem; font-weight:700;
        text-transform:uppercase; letter-spacing:.1em; color:var(--tan);
        position:sticky; top:0; background:var(--paper); z-index:1;
    }

    .tmpl-grid {
        display:grid; grid-template-columns:1fr 1fr; gap:.45rem; padding:.65rem;
    }

    .tmpl-item {
        border:2px solid var(--border); border-radius:9px; overflow:hidden;
        cursor:pointer; transition:all .14s; background:#fff;
    }
    .tmpl-item:hover { border-color:var(--tan); transform:translateY(-1px); box-shadow:0 3px 10px rgba(44,36,22,.1); }
    .tmpl-item.active { border-color:var(--accent); box-shadow:0 0 0 3px rgba(193,127,62,.15); }

    .tmpl-item-thumb { height:60px; overflow:hidden; }
    .tmpl-item-label {
        padding:.22rem .4rem .3rem; display:flex; align-items:center;
        justify-content:space-between; font-size:.66rem; font-weight:600;
        color:var(--dark); font-family:var(--sans);
    }

    /* ── Colour section ── */
    .color-section { padding:.65rem 1rem; border-top:1px solid var(--border); }
    .color-section-head {
        font-family:var(--mono); font-size:.67rem; font-weight:700;
        text-transform:uppercase; letter-spacing:.1em; color:var(--tan); margin-bottom:.55rem;
    }
    .color-dots { display:flex; flex-wrap:wrap; gap:.35rem; margin-bottom:.6rem; }
    .color-dot {
        width:21px; height:21px; border-radius:50%; cursor:pointer;
        border:2px solid transparent; transition:transform .14s, border-color .14s; flex-shrink:0;
    }
    .color-dot:hover { transform:scale(1.2); }
    .color-dot.active { border-color:var(--dark); transform:scale(1.15); box-shadow:0 0 0 2px rgba(255,255,255,.8); }
    .color-row { display:flex; align-items:center; gap:.45rem; font-size:.7rem; color:var(--muted); font-family:var(--mono); }
    .color-row input[type=color] { width:28px; height:24px; border:1px solid var(--border); border-radius:5px; cursor:pointer; padding:2px; background:var(--cream); }
    .color-row input[type=text] { width:76px; padding:.26rem .48rem; background:var(--cream); border:1px solid var(--border); border-radius:5px; font-size:.7rem; font-family:var(--mono); color:var(--dark); outline:none; }
    .color-row input[type=text]:focus { border-color:var(--accent); }

    /* ── Quick edit section ── */
    .qe-section { padding:.65rem 1rem; border-top:1px solid var(--border); flex:1; }
    .qe-section-head {
        font-family:var(--mono); font-size:.67rem; font-weight:700;
        text-transform:uppercase; letter-spacing:.1em; color:var(--tan);
        margin-bottom:.55rem; display:flex; align-items:center;
        justify-content:space-between; cursor:pointer; user-select:none;
    }
    .qe-section-head:hover { color:var(--accent); }
    .qe-field { margin-bottom:.5rem; }
    .qe-field label { display:block; font-size:.63rem; font-weight:600; color:var(--muted); font-family:var(--mono); text-transform:uppercase; letter-spacing:.06em; margin-bottom:.18rem; }
    .qe-field input, .qe-field textarea { width:100%; padding:.38rem .55rem; background:var(--cream); border:1px solid var(--border); border-radius:6px; font-size:.78rem; color:var(--dark); font-family:var(--sans); outline:none; transition:border-color .2s; }
    .qe-field input:focus, .qe-field textarea:focus { border-color:var(--accent); background:#fff; }
    .qe-field textarea { resize:vertical; min-height:60px; line-height:1.5; }

    /* ── Right panel ── */
    .tmpl-right { display:flex; flex-direction:column; overflow:hidden; background:var(--warm-white); }

    /* ══════════════════════════════════════════════════════
       WORD-LIKE FORMATTING TOOLBAR
    ══════════════════════════════════════════════════════ */
    .fmt-toolbar {
        display:flex; align-items:center; gap:0;
        padding:0 .6rem;
        border-bottom:1px solid var(--border);
        background:#f8f7f5;
        flex-shrink:0;
        min-height:38px;
        flex-wrap:wrap;
        overflow-x:auto;
    }

    .fmt-group {
        display:flex; align-items:center; gap:1px;
        padding:4px 2px;
        flex-shrink:0;
    }

    .fmt-sep {
        width:1px; height:22px; background:#d8d3cc;
        margin:0 4px; flex-shrink:0; align-self:center;
    }

    /* Buttons */
    .fmt-btn {
        display:inline-flex; align-items:center; justify-content:center;
        width:26px; height:26px; min-width:26px;
        border:1px solid transparent; border-radius:4px;
        background:none; cursor:pointer;
        font-size:.78rem; color:#3d3830;
        transition:background .12s, border-color .12s;
        font-family:var(--sans); flex-shrink:0;
        user-select:none; -webkit-user-select:none;
    }
    .fmt-btn:hover { background:#ede9e2; border-color:#ccc7be; }
    .fmt-btn.active { background:#dde3f4; border-color:#7b96d1; color:#1a3c8a; }
    .fmt-btn:active { background:#d4d0c8; }

    /* Wide buttons (text label) */
    .fmt-btn-wide {
        width:auto; padding:0 7px; font-size:.7rem; letter-spacing:.03em;
    }

    /* Font family select */
    .fmt-sel-font {
        height:26px; width:128px; padding:0 .35rem;
        border:1px solid #cdc8bf; border-radius:4px;
        background:#fff; font-size:.76rem; color:#3d3830;
        font-family:var(--sans); outline:none; cursor:pointer;
    }
    .fmt-sel-font:focus { border-color:#8b7355; }

    /* Font size input */
    .fmt-size-wrap {
        display:flex; align-items:center; gap:1px;
    }
    .fmt-size-input {
        width:36px; height:26px; padding:0 4px; text-align:center;
        border:1px solid #cdc8bf; border-radius:4px 0 0 4px;
        background:#fff; font-size:.76rem; color:#3d3830;
        font-family:var(--sans); outline:none;
    }
    .fmt-size-input:focus { border-color:#8b7355; }
    .fmt-size-arrows {
        display:flex; flex-direction:column; border:1px solid #cdc8bf;
        border-left:none; border-radius:0 4px 4px 0; overflow:hidden;
    }
    .fmt-sz-btn {
        width:18px; height:13px; background:#f0ede8; border:none;
        cursor:pointer; display:flex; align-items:center; justify-content:center;
        font-size:6px; color:#666; padding:0; line-height:1;
    }
    .fmt-sz-btn:hover { background:#e0dbd2; }
    .fmt-sz-btn:first-child { border-bottom:1px solid #cdc8bf; }

    /* Underline button decoration */
    #fmtUnderline { text-decoration:underline; }

    /* Strikethrough button */
    #fmtStrike { text-decoration:line-through; }

    /* Color picker widgets — like Word's "A" with color bar underneath */
    .fmt-color-wrap {
        display:inline-flex; flex-direction:column; align-items:center;
        cursor:pointer; padding:2px 4px; border:1px solid transparent;
        border-radius:4px; gap:1px; height:26px; justify-content:center;
        position:relative;
    }
    .fmt-color-wrap:hover { background:#ede9e2; border-color:#ccc7be; }

    .fmt-color-letter {
        font-size:.8rem; font-weight:700; color:#3d3830;
        line-height:1; display:block; pointer-events:none;
    }
    .fmt-color-bar {
        height:3px; width:18px; border-radius:1px; pointer-events:none;
    }
    .fmt-hidden-color {
        position:absolute; width:100%; height:100%; opacity:0;
        cursor:pointer; left:0; top:0; border:none; padding:0;
    }

    /* Line spacing select */
    .fmt-sel-small {
        height:26px; padding:0 .3rem;
        border:1px solid #cdc8bf; border-radius:4px;
        background:#fff; font-size:.72rem; color:#3d3830;
        font-family:var(--mono); outline:none; cursor:pointer;
    }
    .fmt-sel-small:focus { border-color:#8b7355; }

    /* ── Preview area ── */
    .preview-area-wrap {
        flex: 1; overflow-y: auto;
        padding: 2rem 2.5rem;
        background: #c8c4bc;  /* neutral gray background — makes white paper pop */
    }

    /* A4 paper: 210mm × 297mm at 96 dpi ≈ 794px × 1123px */
    .preview-paper {
        background: #fff;
        box-shadow:
            0 1px 3px rgba(0,0,0,.12),
            0 4px 16px rgba(0,0,0,.10),
            0 12px 40px rgba(0,0,0,.08);
        width: 210mm;         /* exact A4 width */
        min-height: 297mm;    /* exact A4 height */
        margin: 0 auto;
        border-radius: 1px;
        outline: none;
        cursor: text;
        /* Fonts scaled to professional sizes via scaleTemplateFonts() in renderPreview() */
    }

    /* ── Action bar ── */
    .tmpl-action-bar {
        display:flex; align-items:center; gap:.55rem; flex-wrap:wrap;
        padding:.6rem 1rem; border-top:1px solid var(--border);
        background:var(--paper); flex-shrink:0;
    }

    .btn-a {
        display:inline-flex; align-items:center; gap:.32rem;
        padding:.44rem .9rem; border-radius:7px; font-size:.78rem;
        font-weight:600; cursor:pointer; font-family:var(--sans);
        border:none; transition:all .18s; text-decoration:none; flex-shrink:0;
    }
    .btn-a:disabled { opacity:.6; cursor:not-allowed; }
    .btn-save  { background:var(--green); color:#fff; }
    .btn-save:hover  { background:#3d6b4a; }
    .btn-pdf   { background:var(--dark); color:var(--cream); }
    .btn-pdf:hover   { background:var(--charcoal); }
    .btn-docx  { background:#1565c0; color:#fff; }
    .btn-docx:hover  { background:#0d47a1; }
    .btn-back  { background:none; color:var(--muted); border:1px solid var(--border); }
    .btn-back:hover  { border-color:var(--tan); color:var(--dark); }
    .btn-edit  { background:var(--accent-light); color:var(--accent); border:1px solid var(--accent); margin-left:auto; }
    .btn-edit:hover  { background:var(--accent); color:#fff; }
    .btn-png   { background:#0891b2; color:#fff; }
    .btn-png:hover   { background:#0e7490; }

    /* Saving indicator */
    .save-status {
        font-size:.72rem; color:var(--muted); font-family:var(--mono);
        display:none; align-items:center; gap:.3rem;
    }
    .save-status.visible { display:flex; }

    /* ── Print / Export CSS ── */
    @@media print {
        body > *:not(#printRoot) { display:none !important; }
        #printRoot { display:block !important; }
        .tmpl-shell { display:none !important; }
        .print-frame {
            display:block !important;
            width:100%; margin:0; padding:0;
            box-shadow:none; border:none; border-radius:0;
        }
    }

    /* Responsive — shrink paper on small screens */
    @@media (max-width:900px) {
        .tmpl-shell { grid-template-columns:1fr; height:auto; }
        .tmpl-left { max-height:300px; }
        .tmpl-grid { grid-template-columns:repeat(3,1fr); }
    }
    @@media (max-width:1100px) {
        /* Scale A4 paper down so it fits the right panel without horizontal scroll */
        .preview-paper, .cl-preview-paper {
            width: 90%;
            min-height: auto;
        }
    }
    @@media (max-width:600px) {
        .tmpl-grid { grid-template-columns:repeat(2,1fr); }
    }

    /* ══════════════════════════════════════════════════════════
       WORKFLOW PROGRESS BAR (shared)
    ══════════════════════════════════════════════════════════ */
    .ciq-progress {
        display: flex;
        align-items: center;
        padding: .5rem .9rem;
        background: var(--warm-white);
        border: 1px solid var(--border);
        border-radius: 8px;
    }
    .ciq-step {
        display: flex;
        align-items: center;
        gap: .38rem;
        flex-shrink: 0;
    }
    .ciq-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--border);
        flex-shrink: 0;
    }
    .ciq-step-label {
        font-size: .68rem;
        font-weight: 600;
        color: var(--muted);
        font-family: var(--mono);
        white-space: nowrap;
    }
    .ciq-line { flex:1; height:1px; background:var(--border); margin:0 .5rem; min-width:12px; }
    .ciq-step.active .ciq-dot        { background: var(--accent); }
    .ciq-step.active .ciq-step-label { color: var(--accent); }
    .ciq-step.done   .ciq-dot        { background: var(--green); }
    .ciq-step.done   .ciq-step-label { color: var(--green); }

    /* ══════════════════════════════════════════════════════════
       CAREER INTELLIGENCE CENTER
    ══════════════════════════════════════════════════════════ */
    .cic-wrap {
        background: var(--cream);
        padding: 1.75rem 2rem 2.5rem;
        margin: 0 -2rem -2rem;
        border-top: 1px solid var(--border);
    }
    .cic-toprow {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.25rem;
        margin-bottom: 1.1rem;
        flex-wrap: wrap;
    }
    .cic-title {
        font-family: var(--serif);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: .18rem;
    }
    .cic-sub {
        font-size: .72rem;
        color: var(--muted);
        font-family: var(--mono);
    }
    .cic-header-scores {
        display: flex;
        gap: .5rem;
        align-items: center;
        flex-wrap: wrap;
    }
    .cic-score-pill {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .24rem .7rem;
        border-radius: 100px;
        border: 1px solid var(--border);
        background: #fff;
        font-size: .7rem;
        font-family: var(--mono);
    }
    .cic-score-pill .sp-label { color: var(--muted); }
    .cic-score-pill .sp-value { font-weight: 700; color: var(--dark); }
    .cic-score-pill.good .sp-value { color: var(--green); }
    .cic-score-pill.warn .sp-value { color: #d97706; }
    .cic-score-pill.bad  .sp-value { color: var(--red); }

    /* Grid */
    .cic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: .8rem;
    }

    /* Card */
    .cic-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition: box-shadow .15s;
    }
    .cic-card:hover { box-shadow: 0 2px 10px rgba(44,36,22,.07); }
    .cic-card-head {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .85rem 1rem;
    }
    .cic-card-icon {
        width: 34px; height: 34px;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: .95rem;
        flex-shrink: 0;
    }
    .cic-card-info { flex: 1; min-width: 0; }
    .cic-card-name {
        font-size: .82rem; font-weight: 700;
        color: var(--dark); margin-bottom: .08rem;
        font-family: var(--sans);
    }
    .cic-card-desc {
        font-size: .67rem; color: var(--muted);
        font-family: var(--mono);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cic-card-score {
        font-size: .78rem; font-weight: 700;
        font-family: var(--mono); color: var(--muted);
        flex-shrink: 0; min-width: 30px; text-align: center;
    }
    .cic-card-score.good { color: var(--green); }
    .cic-card-score.warn { color: #d97706; }
    .cic-card-score.bad  { color: var(--red); }
    .cic-run-btn {
        flex-shrink: 0;
        padding: .36rem .8rem;
        background: var(--dark); color: var(--cream);
        border: none; border-radius: 7px;
        font-size: .72rem; font-weight: 600;
        cursor: pointer; font-family: var(--sans);
        transition: background .14s; white-space: nowrap;
    }
    .cic-run-btn:hover:not(:disabled) { background: var(--charcoal); }
    .cic-run-btn:disabled { opacity: .5; cursor: not-allowed; }
    .cic-card-body {
        border-top: 1px solid var(--border);
        padding: .9rem 1rem;
        font-size: .8rem; color: var(--charcoal);
        line-height: 1.6; background: var(--cream);
    }
    .cic-sub-label {
        font-size: .63rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .08em;
        color: var(--tan); font-family: var(--mono);
        margin: .7rem 0 .32rem;
    }
    .cic-sub-label:first-child { margin-top: 0; }
    .cic-tag {
        display: inline-flex; align-items: center;
        padding: 2px 9px; border-radius: 100px;
        font-size: .68rem; font-weight: 600; margin: 2px;
    }
    .cic-tag.red    { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
    .cic-tag.green  { background:#dcfce7; color:#15803d; border:1px solid #86efac; }
    .cic-tag.amber  { background:#fffbeb; color:#92400e; border:1px solid #fde68a; }
    .cic-tag.blue   { background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; }
    .cic-item {
        display: flex; align-items: flex-start;
        gap: .4rem; margin-bottom: .28rem; font-size: .78rem;
    }
    .cic-item-ic { flex-shrink: 0; margin-top: .12rem; font-size: .7rem; }
    .cic-input {
        width: 100%; padding: .42rem .7rem;
        background: #fff; border: 1px solid var(--border);
        border-radius: 7px; font-size: .8rem; font-family: var(--sans);
        outline: none; transition: border-color .15s;
        box-sizing: border-box;
    }
    .cic-input:focus { border-color: var(--accent); }

    /* ── Workspace switcher ── */
    .ws-switcher {
        display: flex;
        gap: 2px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 7px;
        padding: 2px;
        flex-shrink: 0;
    }
    .ws-btn {
        padding: .3rem 1rem;
        border: none;
        background: none;
        border-radius: 5px;
        font-size: .75rem;
        font-weight: 500;
        color: var(--muted);
        cursor: pointer;
        font-family: var(--sans);
        transition: all .12s;
        white-space: nowrap;
    }
    .ws-btn:hover { color: var(--dark); }
    .ws-btn.active {
        background: #fff;
        color: var(--dark);
        box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }

    /* ── CL sidebar ── */
    #clSidebarContent {
        display: none;
        flex-direction: column;
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .cl-gen-head {
        padding: .6rem 1rem;
        border-bottom: 1px solid var(--border);
        font-family: var(--mono);
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--tan);
        background: var(--paper);
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .cl-section { padding: .65rem .9rem; border-bottom: 1px solid var(--border); }
    .cl-section:last-child { border-bottom: none; }
    .cl-field { margin-bottom: .55rem; }
    .cl-field label {
        display: block;
        font-size: .63rem;
        font-weight: 600;
        color: var(--muted);
        font-family: var(--mono);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .2rem;
    }
    .cl-field input,
    .cl-field select,
    .cl-field textarea {
        width: 100%;
        padding: .38rem .55rem;
        background: var(--cream);
        border: 1px solid var(--border);
        border-radius: 6px;
        font-size: .78rem;
        color: var(--dark);
        font-family: var(--sans);
        outline: none;
        transition: border-color .15s;
        box-sizing: border-box;
    }
    .cl-field input:focus,
    .cl-field select:focus,
    .cl-field textarea:focus { border-color: var(--accent); background: #fff; }
    .cl-field textarea { resize: vertical; line-height: 1.5; }

    /* Chips */
    .cl-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem;
        margin-top: .25rem;
    }
    .cl-chip {
        padding: .18rem .55rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: #fff;
        color: var(--muted);
        font-size: .7rem;
        font-weight: 500;
        cursor: pointer;
        font-family: var(--sans);
        transition: border-color .1s, color .1s, background .1s;
        white-space: nowrap;
    }
    .cl-chip:hover { border-color: var(--accent); color: var(--accent); }
    .cl-chip.active {
        background: var(--accent-light, #EEF2FF);
        border-color: var(--accent);
        color: var(--accent);
