@{
    ViewData["Title"] = "CV Builder";
    ViewData["Page"] = "cvbuilder";
    var cvRecordId = ViewData["CVRecordId"]?.ToString() ?? "";
}

<style>
    .builder-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .builder-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
    }

    .builder-topbar-left {
        display: flex;
        align-items: center;
        gap: .9rem;
    }

    .builder-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--green-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .builder-title {
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.2rem;
        color: var(--dark);
        margin-bottom: .1rem;
    }

    .builder-sub {
        font-size: .78rem;
        color: var(--muted);
    }

    .autosave-badge {
        font-size: .72rem;
        font-family: var(--mono);
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: .35rem;
    }

        .autosave-badge.saved {
            color: var(--green);
        }

    /* ── Upload row ── */
    .upload-row {
        display: flex;
        gap: .75rem;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-upload {
        display: flex;
        align-items: center;
        gap: .4rem;
        padding: .55rem 1rem;
        border-radius: 9px;
        border: 1.5px dashed var(--border);
        background: var(--cream);
        color: var(--muted);
        font-size: .8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .2s;
        font-family: var(--sans);
    }

        .btn-upload:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-light);
        }

        .btn-upload.has-file {
            border-color: var(--green);
            color: var(--green);
            background: var(--green-light);
            border-style: solid;
        }

    /* ── Form card ── */
    .form-card {
        background: var(--warm-white);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .form-card-head {
        padding: .85rem 1.1rem;
        border-bottom: 1px solid var(--border);
        background: var(--paper);
        font-family: var(--mono);
        font-size: .75rem;
        font-weight: 500;
        color: var(--charcoal);
    }

    .form-card-body {
        padding: 1.25rem;
    }

    /* ── Section labels ── */
    .fsec {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--tan);
        font-family: var(--mono);
        margin: 1.1rem 0 .65rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .fsec::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

    /* ── Form controls ── */
    .fr {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .85rem;
        margin-bottom: .85rem;
    }

    .fg {
        display: flex;
        flex-direction: column;
        gap: .28rem;
    }

        .fg.full {
            grid-column: 1 / -1;
        }

    label {
        font-size: .73rem;
        font-weight: 500;
        color: var(--charcoal);
        font-family: var(--sans);
    }

        label .req {
            color: var(--accent);
        }

    input[type=text], input[type=email], input[type=tel], input[type=url], textarea {
        width: 100%;
        padding: .58rem .85rem;
        background: var(--cream);
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: .84rem;
        color: var(--dark);
        font-family: var(--sans);
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }

        input:focus, textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(193,127,62,.08);
            background: #fff;
        }

        input::placeholder, textarea::placeholder {
            color: var(--tan);
        }

    textarea {
        resize: vertical;
        min-height: 80px;
        line-height: 1.5;
    }

    /* ── Photo ── */
    .photo-row {
        display: flex;
        align-items: center;
        gap: .85rem;
        margin-bottom: .85rem;
    }

    .photo-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        border: 2px dashed var(--border);
        overflow: hidden;
        flex-shrink: 0;
        background: var(--paper);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: var(--tan);
    }

        .photo-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
            border-radius: 50%;
        }

    /* ── Tags ── */
    .tags-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        padding: .5rem .7rem;
        background: var(--cream);
        border: 1px solid var(--border);
        border-radius: 8px;
        min-height: 42px;
        cursor: text;
    }

        .tags-wrap:focus-within {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(193,127,62,.08);
            background: #fff;
        }

    .tag {
        display: flex;
        align-items: center;
        gap: .3rem;
        background: var(--dark);
        color: var(--cream);
        font-size: .75rem;
        padding: .2rem .55rem;
        border-radius: 100px;
        font-family: var(--sans);
    }

    .tag-remove {
        cursor: pointer;
        font-size: .7rem;
        color: var(--tan);
        background: none;
        border: none;
        padding: 0;
        line-height: 1;
    }

        .tag-remove:hover {
            color: #fff;
        }

    .tags-input {
        border: none;
        background: transparent;
        outline: none;
        font-size: .82rem;
        color: var(--dark);
        font-family: var(--sans);
        min-width: 120px;
        flex: 1;
        padding: .1rem 0;
    }

    /* ── Repeat blocks ── */
    .repeat-block {
        background: var(--cream);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: .85rem;
    }

    .repeat-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .75rem;
    }

    .repeat-title {
        font-size: .78rem;
        font-weight: 700;
        color: var(--dark);
        font-family: var(--sans);
    }

    .btn-remove {
        font-size: .72rem;
        color: var(--red);
        background: none;
        border: 1px solid var(--red);
        border-radius: 6px;
        padding: .18rem .5rem;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-remove:hover {
            background: var(--red);
            color: #fff;
        }

    .btn-add {
        display: flex;
        align-items: center;
        gap: .4rem;
        width: 100%;
        padding: .52rem;
        border-radius: 8px;
        border: 1px dashed var(--border);
        background: transparent;
        color: var(--muted);
        font-size: .8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .2s;
        font-family: var(--sans);
        justify-content: center;
        margin-bottom: .85rem;
    }

        .btn-add:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-light);
        }

    /* ── Job requirements box ── */
    .req-box {
        background: #fffbeb;
        border: 1px solid #fcd34d;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1.25rem;
    }

    .req-box-title {
        font-size: .72rem;
        font-weight: 700;
        color: #92400e;
        font-family: var(--mono);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    /* ── Buttons ── */
    .btn-ghost {
        display: flex;
        align-items: center;
        gap: .35rem;
        padding: .42rem .9rem;
        border-radius: 7px;
        border: 1px solid var(--border);
        background: var(--warm-white);
        color: var(--muted);
        font-size: .78rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .2s;
        font-family: var(--sans);
    }

        .btn-ghost:hover {
            border-color: var(--tan);
            color: var(--dark);
        }

    .gen-btn {
        width: 100%;
        padding: .9rem;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 3px 16px rgba(74,124,89,.25);
        transition: all .2s;
        margin-top: .75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }

        .gen-btn:hover {
            background: #3d6b4a;
            transform: translateY(-1px);
        }

        .gen-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }

    .next-btn {
        display: none;
        width: 100%;
        padding: .9rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 3px 16px rgba(193,127,62,.3);
        transition: all .2s;
        margin-top: .75rem;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }

        .next-btn:hover {
            background: #a86c30;
            transform: translateY(-1px);
        }

        .next-btn.visible {
            display: flex;
        }

    /* ── Preview ── */
    .preview-panel {
        position: sticky;
        top: 1rem;
    }

    .preview-card {
        background: var(--warm-white);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .preview-head {
        padding: .85rem 1.1rem;
        border-bottom: 1px solid var(--border);
        background: var(--paper);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .preview-head-label {
        font-family: var(--mono);
        font-size: .75rem;
        font-weight: 500;
        color: var(--charcoal);
    }

    .preview-body {
        padding: 1.5rem;
        min-height: 500px;
        overflow-y: auto;
        max-height: 680px;
    }

    @@media (max-width: 960px) {
        .builder-layout {
            grid-template-columns: 1fr;
        }

        .preview-panel {
            position: static;
        }

        .fr {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Hidden file inputs -->
<input type="file" id="cvFileInput" accept=".pdf,.docx,.png,.jpg,.jpeg,.webp" style="display:none;" />
<input type="file" id="photoFileInput" accept="image/*" style="display:none;" />

<!-- Workflow progress -->
<div class="ciq-progress" id="ciqProgress">
    <div class="ciq-step active" id="ciq-step-1">
        <div class="ciq-dot"></div>
        <span class="ciq-step-label">CV Created</span>
    </div>
    <div class="ciq-line"></div>
    <div class="ciq-step" id="ciq-step-2">
        <div class="ciq-dot"></div>
        <span class="ciq-step-label">Template Selected</span>
    </div>
    <div class="ciq-line"></div>
    <div class="ciq-step" id="ciq-step-3">
        <div class="ciq-dot"></div>
        <span class="ciq-step-label">Analysis Complete</span>
    </div>
    <div class="ciq-line"></div>
    <div class="ciq-step" id="ciq-step-4">
        <div class="ciq-dot"></div>
        <span class="ciq-step-label">Export Ready</span>
    </div>
</div>

<!-- Top bar -->
<div class="builder-topbar">
    <div class="builder-topbar-left">
        <div class="builder-icon">&#128196;</div>
        <div>
            <div class="builder-title">CV Builder</div>
            <div class="builder-sub">Upload your CV or fill in your details — AI crafts your perfect CV</div>
        </div>
    </div>
    <div style="display:flex;align-items:center;gap:.75rem;">
        <span class="autosave-badge" id="autosaveBadge">&#9679; Not saved yet</span>
        <a href="/Home/Index" class="btn-ghost">&#8592; Dashboard</a>
    </div>
</div>

<!-- Upload CV row (button 1 = extract CV, upload status) -->
<div class="upload-row">
    <button class="btn-upload" id="uploadCVBtn" type="button">
        &#128196; Upload CV to Extract
        <span style="font-size:.68rem;opacity:.7;">(PDF, DOCX or Image of CV)</span>
    </button>
    <div id="uploadStatus"
         style="font-size:.78rem;color:var(--muted);font-family:var(--mono);display:flex;align-items:center;"></div>
</div>

<!-- Main layout -->
<div class="builder-layout">

    <!-- LEFT: Form -->
    <div>
        <div class="form-card">
            <div class="form-card-head">&#128221; Your Information</div>
            <div class="form-card-body" id="cvFormBody">

                <!-- Contact -->
                <div class="fsec">&#128100; Contact Information</div>
                <div class="fr">
                    <div class="fg">
                        <label>Full Name <span class="req">*</span></label>
                        <input type="text" id="fullName" placeholder="First and last name" />
                    </div>
                    <div class="fg">
                        <label>Target Job Title <span class="req">*</span></label>
                        <input type="text" id="jobTitle" placeholder="e.g. Software Engineer" />
                    </div>
                </div>
                <div class="fr">
                    <div class="fg">
                        <label>Email <span class="req">*</span></label>
                        <input type="email" id="email" placeholder="you@email.com" />
                    </div>
                    <div class="fg">
                        <label>Phone <span class="req">*</span></label>
                        <input type="tel" id="phone" placeholder="+1 234 567 8900" />
                    </div>
                </div>
                <div class="fr">
                    <div class="fg">
                        <label>Location <span class="req">*</span> <small style="font-weight:400;color:var(--muted);">City, Country</small></label>
                        <input type="text" id="location" placeholder="e.g. Seattle, USA" />
                    </div>
                    <div class="fg">
                        <label>LinkedIn URL</label>
                        <input type="url" id="linkedin" placeholder="linkedin.com/in/yourname" />
                    </div>
                </div>

                <!-- Profile photo (button 2 = profile photo only) -->
                <div class="fsec">&#128247; Profile Photo <small style="font-weight:400;text-transform:none;letter-spacing:0;">(optional)</small></div>
                <div class="photo-row">
                    <div class="photo-circle">
                        <span id="photoIcon">&#128100;</span>
                        <img id="photoPreview" alt="Your photo" />
                    </div>
                    <div>
                        <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                            <button class="btn-ghost" id="changePhotoBtn" type="button">
                                &#128247; Choose Photo
                            </button>
                            <button class="btn-ghost" id="removePhotoBtn" type="button"
                                    style="display:none;color:var(--red);border-color:var(--red);">
                                &#10005; Remove
                            </button>
                        </div>
                        <div style="font-size:.7rem;color:var(--muted);margin-top:.35rem;font-family:var(--mono);">
                            JPG or PNG · Max 5MB · Appears in templates that support photos
                        </div>
                    </div>
                </div>

                <!-- Summary -->
                <div class="fsec">&#128221; Professional Summary</div>
                <div class="fg" style="margin-bottom:.85rem;">
                    <label>Professional Summary <span class="req">*</span> <small style="font-weight:400;color:var(--muted);">(3–4 sentences)</small></label>
                    <textarea id="summary" rows="4"
                              placeholder="Summarize your career, key strengths, and goals. e.g. Results-driven Software Engineer with 4+ years building scalable backend systems in C++ and .NET..."></textarea>
                </div>

                <!-- Experience (optional) -->
                <div class="fsec">
                    &#128188; Work Experience
                    <small style="font-weight:400;text-transform:none;letter-spacing:0;font-size:.68rem;">(optional)</small>
                </div>
                <div id="expContainer"><div id="exp-1"></div></div>
                <button type="button" class="btn-add" onclick="addExp()">&#43; Add Another Experience</button>

                <!-- Education -->
                <div class="fsec">&#127979; Education</div>
                <div id="eduContainer"><div id="edu-1"></div></div>
                <button type="button" class="btn-add" onclick="addEdu()">&#43; Add Another Education</button>

                <!-- Skills -->
                <div class="fsec">&#9889; Skills</div>
                <div class="fg" style="margin-bottom:.85rem;">
                    <label>Key Skills <span class="req">*</span> <small style="font-weight:400;color:var(--muted);">Press Enter or comma to add</small></label>
                    <div class="tags-wrap" id="skillsWrap">
                        <input class="tags-input" id="skillsInput" placeholder="Type a skill and press Enter..." />
                    </div>
                    <input type="hidden" id="skillsHidden" />
                </div>

                <!-- Extras -->
                <div class="fsec">&#127942; Extras <small style="font-weight:400;text-transform:none;letter-spacing:0;">(optional)</small></div>

                <div class="fg" style="margin-bottom:.85rem;">
                    <label>Certifications <small style="font-weight:400;color:var(--muted);">Press Enter or comma to add</small></label>
                    <div class="tags-wrap" id="certsWrap">
                        <input class="tags-input" id="certsInput" placeholder="e.g. AWS Solutions Architect, PMP..." />
                    </div>
                    <input type="hidden" id="certsHidden" />
                </div>

                <div class="fg" style="margin-bottom:.85rem;">
                    <label>Languages <small style="font-weight:400;color:var(--muted);">Press Enter or comma to add</small></label>
                    <div class="tags-wrap" id="langsWrap">
                        <input class="tags-input" id="langsInput" placeholder="e.g. English, Amharic, Arabic..." />
                    </div>
                    <input type="hidden" id="langsHidden" />
                </div>

                <!-- Job requirements -->
                <div class="req-box">
                    <div class="req-box-title">
                        &#127919; Job Requirements
                        <small style="font-weight:400;text-transform:none;letter-spacing:0;font-size:.68rem;">
                            (optional — helps AI tailor &amp; bypass AI detection)
                        </small>
                    </div>
                    <textarea id="jobRequirements" rows="4"
                              style="background:#fff;border-color:#fcd34d;width:100%;padding:.58rem .85rem;border-radius:8px;font-size:.84rem;color:var(--dark);font-family:var(--sans);outline:none;resize:vertical;line-height:1.5;"
                              placeholder="Paste the full job description here. The AI will tailor your CV to match this role closely."></textarea>
                    <div style="font-size:.7rem;color:#92400e;margin-top:.4rem;font-family:var(--mono);">
                        &#128161; The more detail you provide, the better the match.
                    </div>
                </div>

                <!-- Buttons -->
                <button id="generateBtn" class="gen-btn" type="button">&#10024; Get My CV</button>
                <button id="nextBtn" class="next-btn" type="button" onclick="goToTemplates()">
                    Choose a Template &#8594;
                </button>

                <div style="margin-top:.75rem;padding:10px 14px;background:var(--paper);border:1px solid var(--border);border-radius:10px;font-size:.76rem;color:var(--muted);font-family:var(--mono);display:flex;align-items:center;gap:.5rem;">
                    &#9432; Generate your CV, then choose a template — the Career Intelligence Center will appear with AI analysis tools.
                </div>

            </div>
        </div>
    </div>

    <!-- RIGHT: Preview -->
    <div class="preview-panel">
        <div class="preview-card">
            <div class="preview-head">
                <span class="preview-head-label">&#128065; Live Preview</span>
                <span id="previewStatus" style="font-size:.7rem;color:var(--muted);font-family:var(--mono);"></span>
            </div>
            <div class="preview-scores" id="previewScores">
                <div class="pscore-pill" id="pscoreATS"><span>ATS</span><strong>—</strong></div>
                <div class="pscore-pill" id="pscoreJob"><span>Job Match</span><strong>—</strong></div>
                <div class="pscore-pill" id="pscoreHealth"><span>Health</span><strong>—</strong></div>
            </div>
            <div class="preview-body" id="cvPreview">
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:460px;gap:14px;text-align:center;">
                    <div style="width:64px;height:64px;border-radius:16px;background:var(--paper);display:flex;align-items:center;justify-content:center;font-size:1.7rem;">&#128196;</div>
                    <div style="font-family:var(--serif);font-weight:700;font-size:1.1rem;color:var(--dark);">Your CV will appear here</div>
                    <div style="font-size:.8rem;color:var(--tan);font-family:var(--mono);">Upload a CV or fill in your details and click "Get My CV"</div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- AI STUDIO PANEL                                           -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* AI Studio panel */
    #aiStudioPanel {
        display: none;
        margin-top: 2rem;
        border: 1.5px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        background: var(--warm-white);
    }
    .ais-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .9rem 1.25rem;
        background: linear-gradient(135deg,#1a1a2e,#2d2d5e);
        flex-wrap: wrap;
        gap: .5rem;
    }
    .ais-header-left { display:flex;align-items:center;gap:.75rem; }
    .ais-header-title { font-family:var(--serif);font-weight:700;font-size:1rem;color:#fff; }
    .ais-header-sub { font-size:.7rem;color:rgba(255,255,255,.5);font-family:var(--mono); }
    .ais-close {
        background: rgba(255,255,255,.12); border:none; color:#fff; width:28px;height:28px;
        border-radius:8px; cursor:pointer; font-size:1rem; display:flex;align-items:center;justify-content:center;
    }
    .ais-close:hover { background:rgba(255,255,255,.22); }
    /* Tabs */
    .ais-tabs {
        display: flex;
        background: var(--paper);
        border-bottom: 1px solid var(--border);
        overflow-x: auto;
        gap: 0;
    }
    .ais-tab {
        padding: .65rem 1.1rem;
        font-size: .76rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        border: none;
        background: none;
        border-bottom: 2.5px solid transparent;
        white-space: nowrap;
        font-family: var(--sans);
        transition: all .15s;
    }
    .ais-tab:hover { color: var(--dark); background: var(--cream); }
    .ais-tab.active { color: #4f46e5; border-bottom-color: #4f46e5; }
    /* Pane */
    .ais-pane { padding: 1.25rem; display: none; }
    /* Sections inside pane */
    .ais-section {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
    }
    .ais-section-title {
        font-size: .78rem;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: .85rem;
        font-family: var(--sans);
        display: flex;
        align-items: center;
        gap: .4rem;
    }
    .ais-subsec {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--tan);
        font-family: var(--mono);
        margin: .75rem 0 .4rem;
    }
    /* Form controls inside studio */
    .ais-label {
        font-size: .72rem; font-weight: 500; color: var(--charcoal);
        display: block; margin-bottom: .22rem; font-family: var(--sans);
    }
    .ais-input, .ais-textarea {
        width: 100%; padding: .52rem .8rem;
        background: var(--cream); border: 1px solid var(--border);
        border-radius: 8px; font-size: .84rem; color: var(--dark);
        font-family: var(--sans); outline: none; transition: border-color .2s;
    }
    .ais-textarea { resize: vertical; line-height: 1.5; }
    .ais-input:focus, .ais-textarea:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79,70,229,.07);
        background: #fff;
    }
    .ais-btn {
        display: inline-flex; align-items: center; gap: .35rem;
        padding: .55rem 1.1rem; border-radius: 9px; border: none;
        font-size: .82rem; font-weight: 600; cursor: pointer;
        font-family: var(--sans); transition: all .18s;
    }
    .ais-btn:disabled { opacity: .6; cursor: not-allowed; }
    .ais-btn-primary { background: #4f46e5; color: #fff; }
    .ais-btn-primary:hover:not(:disabled) { background: #4338ca; }
    .ais-btn-green { background: #15803d; color: #fff; }
    .ais-btn-green:hover:not(:disabled) { background: #166534; }
    .ais-btn-teal { background: #0f766e; color: #fff; }
    .ais-btn-teal:hover:not(:disabled) { background: #0d6b63; }
    .ais-btn-purple { background: #7c3aed; color: #fff; }
    .ais-btn-purple:hover:not(:disabled) { background: #6d28d9; }
    .ais-btn-ghost {
        background: none; color: var(--muted); border: 1px solid var(--border);
    }
    .ais-btn-ghost:hover:not(:disabled) { border-color: var(--tan); color: var(--dark); }
    .ais-gr { display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem; }
    .ais-fg { display:flex;flex-direction:column;gap:.22rem;margin-bottom:.75rem; }
    @@media (max-width: 680px) {
        .ais-gr { grid-template-columns: 1fr; }
        .ais-tabs { font-size:.7rem; }
        .ais-tab { padding:.55rem .75rem; }
    }
    /* Inline bullet improve button */
    .btn-improve-bullet {
        font-size:.68rem; padding:2px 8px; background:none;
        border:1px solid #7c3aed; color:#7c3aed; border-radius:5px;
        cursor:pointer; margin-left:6px; white-space:nowrap;
    }
    .btn-improve-bullet:hover { background:#f5f3ff; }
    .bullet-improve-result { display:none; }

    /* ── Workflow progress bar ── */
    .ciq-progress {
        display: flex;
        align-items: center;
        padding: .6rem 1rem;
        background: var(--warm-white);
        border: 1px solid var(--border);
        border-radius: 10px;
        margin-bottom: 1.25rem;
    }
    .ciq-step {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-shrink: 0;
    }
    .ciq-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--border);
        flex-shrink: 0;
        position: relative;
    }
    .ciq-step-label {
        font-size: .7rem;
        font-weight: 600;
        color: var(--muted);
        font-family: var(--mono);
        white-space: nowrap;
    }
    .ciq-line {
        flex: 1;
        height: 1px;
        background: var(--border);
        margin: 0 .55rem;
        min-width: 14px;
    }
    .ciq-step.active .ciq-dot  { background: var(--accent); }
    .ciq-step.active .ciq-step-label { color: var(--accent); }
    .ciq-step.done .ciq-dot    { background: var(--green); }
    .ciq-step.done .ciq-step-label   { color: var(--green); }

    /* ── Preview score widgets ── */
    .preview-scores {
        display: flex;
        gap: .45rem;
        padding: .5rem .9rem;
        border-bottom: 1px solid var(--border);
        background: var(--paper);
        flex-wrap: wrap;
    }
    .pscore-pill {
        display: inline-flex;
        align-items: center;
        gap: .32rem;
        padding: .2rem .6rem;
        border-radius: 100px;
        background: var(--cream);
        border: 1px solid var(--border);
        font-size: .68rem;
        font-family: var(--mono);
    }
    .pscore-pill span  { color: var(--muted); }
    .pscore-pill strong { color: var(--dark); font-weight: 700; }
    .pscore-pill.good strong { color: var(--green); }
    .pscore-pill.warn strong { color: #d97706; }
    .pscore-pill.bad  strong { color: var(--red); }
</style>

<div id="aiStudioPanel">

    <!-- Header -->
    <div class="ais-header">
        <div class="ais-header-left">
            <span style="font-size:1.4rem;">&#129302;</span>
            <div>
                <div class="ais-header-title">AI Studio</div>
                <div class="ais-header-sub">Supercharge your CV with AI-powered tools</div>
            </div>
        </div>
        <button class="ais-close" onclick="closeStudio()" title="Close">&#10005;</button>
    </div>

    <!-- Tabs -->
    <div class="ais-tabs">
        <button class="ais-tab active" data-tab="analysis">&#127919; CV Analysis</button>
        <button class="ais-tab" data-tab="interview">&#127908; Interview Prep</button>
        <button class="ais-tab" data-tab="writing">&#9999; Writing Tools</button>
        <button class="ais-tab" data-tab="versions">&#128193; Versions</button>
        <button class="ais-tab" data-tab="export">&#11015; Export</button>
    </div>

    <!-- ── PANE: Analysis ── -->
    <div class="ais-pane" data-pane="analysis" style="display:block;">
        <div class="ais-section">
            <div class="ais-section-title">&#127775; Full CV Analysis</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6;">
                Get your ATS score, CV health dashboard, job match percentage, and recruiter simulation — all in one click.
            </p>
            <div class="ais-fg">
                <label class="ais-label">Job Description <small style="font-weight:400;">(optional — enables job match analysis)</small></label>
                <textarea class="ais-textarea" id="analysisJobDesc" rows="4" placeholder="Paste the job description here for a tailored match analysis…"></textarea>
            </div>
            <button class="ais-btn ais-btn-primary" id="runAnalysisBtn" onclick="runAnalysis()">
                &#127919; Run Full Analysis
            </button>
        </div>
        <div id="analysisResult">
            <div style="padding:28px;text-align:center;color:var(--muted);font-size:.82rem;font-family:var(--mono);">
                Generate your CV first, then run the analysis to see your scores.
            </div>
        </div>
    </div>

    <!-- ── PANE: Interview Prep ── -->
    <div class="ais-pane" data-pane="interview">
        <div class="ais-section">
            <div class="ais-section-title">&#127908; Interview Question Generator</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6;">
                Get 15 personalised questions (Technical, HR, Behavioral, Project) based on your CV. Add a job description for role-specific questions.
            </p>
            <div class="ais-fg">
                <label class="ais-label">Job Description <small style="font-weight:400;">(optional)</small></label>
                <textarea class="ais-textarea" id="iqJobDesc" rows="3" placeholder="Paste the job description for role-specific questions…"></textarea>
            </div>
            <div style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem;">
                <button class="ais-btn ais-btn-teal" id="genIQBtn" onclick="generateInterviewQuestions()">
                    &#127908; Generate Questions
                </button>
                <select id="iqCatFilter" class="ais-input" style="width:auto;padding:.42rem .7rem;">
                    <option value="all">All Categories</option>
                    <option value="Technical">Technical</option>
                    <option value="HR">HR</option>
                    <option value="Behavioral">Behavioral</option>
                    <option value="Project">Project</option>
                </select>
                <select id="iqDiffFilter" class="ais-input" style="width:auto;padding:.42rem .7rem;">
                    <option value="all">All Difficulties</option>
                    <option value="Easy">Easy</option>
                    <option value="Medium">Medium</option>
                    <option value="Hard">Hard</option>
                </select>
            </div>
        </div>
        <div id="iqResult">
            <div style="padding:20px;text-align:center;color:var(--muted);font-size:.82rem;font-family:var(--mono);">
                Generate your CV, then click "Generate Questions".
            </div>
        </div>
    </div>

    <!-- ── PANE: Writing Tools ── -->
    <div class="ais-pane" data-pane="writing">

        <!-- Bullet Improver -->
        <div class="ais-section">
            <div class="ais-section-title">&#9999; AI Bullet Point Improver</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6;">
                Paste any weak bullet point. The AI rewrites it with action verbs, measurable impact, and ATS keywords.
            </p>
            <div class="ais-gr">
                <div class="ais-fg">
                    <label class="ais-label">Job Title <small style="font-weight:400;">(optional)</small></label>
                    <input class="ais-input" id="bulletJobTitle" placeholder="e.g. Software Engineer" />
                </div>
                <div class="ais-fg">
                    <label class="ais-label">Company <small style="font-weight:400;">(optional)</small></label>
                    <input class="ais-input" id="bulletCompany" placeholder="e.g. Google" />
                </div>
            </div>
            <div class="ais-fg">
                <label class="ais-label">Bullet Point to Improve <span style="color:var(--accent);">*</span></label>
                <textarea class="ais-textarea" id="bulletInput" rows="3" placeholder="e.g. Worked on backend systems and helped improve performance"></textarea>
            </div>
            <button class="ais-btn ais-btn-purple" id="improveBulletBtn" onclick="improveBullet()">
                &#10024; Improve with AI
            </button>
        </div>
        <div id="bulletResult" style="margin-bottom:1rem;"></div>

        <!-- Project Enhancement -->
        <div class="ais-section">
            <div class="ais-section-title">&#128187; Project Enhancement Engine</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6;">
                Turn a rough project description into 4–5 powerful resume-ready bullet points.
            </p>
            <div class="ais-gr">
                <div class="ais-fg">
                    <label class="ais-label">Project Title <span style="color:var(--accent);">*</span></label>
                    <input class="ais-input" id="projTitle" placeholder="e.g. Real-Time Object Detection System" />
                </div>
                <div class="ais-fg">
                    <label class="ais-label">Your Role</label>
                    <input class="ais-input" id="projRole" placeholder="e.g. Lead Developer" />
                </div>
            </div>
            <div class="ais-fg">
                <label class="ais-label">Short Description</label>
                <textarea class="ais-textarea" id="projDesc" rows="2" placeholder="What did the project do? What problem did it solve?"></textarea>
            </div>
            <div class="ais-gr">
                <div class="ais-fg">
                    <label class="ais-label">Tools / Technologies</label>
                    <input class="ais-input" id="projTools" placeholder="e.g. Python, TensorFlow, OpenCV, AWS" />
                </div>
                <div class="ais-fg">
                    <label class="ais-label">Impact / Result</label>
                    <input class="ais-input" id="projImpact" placeholder="e.g. 92% accuracy, 10k users" />
                </div>
            </div>
            <button class="ais-btn ais-btn-green" id="enhanceProjBtn" onclick="enhanceProject()">
                &#128161; Generate Project Bullets
            </button>
        </div>
        <div id="projResult" style="margin-bottom:1rem;"></div>

        <!-- LinkedIn Generator -->
        <div class="ais-section">
            <div class="ais-section-title">&#128279; LinkedIn Profile Generator</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6;">
                Generate a complete LinkedIn profile: headline, About section, experience descriptions, and skills list.
            </p>
            <div class="ais-fg">
                <label class="ais-label">Target Role <small style="font-weight:400;">(optional)</small></label>
                <input class="ais-input" id="liTargetRole" placeholder="e.g. Senior Software Engineer" />
            </div>
            <button class="ais-btn ais-btn-primary" id="genLinkedInBtn" onclick="generateLinkedIn()"
                    style="background:#0077b5;">
                &#128279; Generate LinkedIn Profile
            </button>
        </div>
        <div id="linkedinResult"></div>

    </div>

    <!-- ── PANE: Versions ── -->
    <div class="ais-pane" data-pane="versions">
        <div class="ais-section">
            <div class="ais-section-title">&#128193; CV Version Management</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6;">
                Manage all your saved CV versions. Duplicate, rename, or open any version.
            </p>
            <button class="ais-btn ais-btn-ghost" onclick="loadVersions()" style="margin-bottom:1rem;">
                &#8635; Refresh
            </button>
        </div>
        <div id="versionsResult">
            <div style="padding:20px;text-align:center;color:var(--muted);font-size:.82rem;font-family:var(--mono);">
                Click the tab to load your saved versions.
            </div>
        </div>
    </div>

    <!-- ── PANE: Export ── -->
    <div class="ais-pane" data-pane="export">
        <div class="ais-section">
            <div class="ais-section-title">&#11015; Export Your CV</div>
            <p style="font-size:.8rem;color:var(--muted);margin-bottom:1rem;line-height:1.6;">
                Export your generated CV in multiple formats. Generate your CV first using the form above.
            </p>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem;">

                <div style="padding:16px;background:#fff;border:1px solid var(--border);border-radius:10px;text-align:center;">
                    <div style="font-size:1.6rem;margin-bottom:6px;">&#128196;</div>
                    <div style="font-size:.82rem;font-weight:600;color:var(--dark);margin-bottom:4px;">PDF</div>
                    <div style="font-size:.72rem;color:var(--muted);margin-bottom:10px);">With template styling</div>
                    <button id="export-pdf-btn" class="ais-btn ais-btn-primary" style="width:100%;" onclick="exportAs('pdf')">
                        Download PDF
                    </button>
                </div>

                <div style="padding:16px;background:#fff;border:1px solid var(--border);border-radius:10px;text-align:center;">
                    <div style="font-size:1.6rem;margin-bottom:6px;">&#128195;</div>
                    <div style="font-size:.82rem;font-weight:600;color:var(--dark);margin-bottom:4px;">DOCX</div>
                    <div style="font-size:.72rem;color:var(--muted);margin-bottom:10px;">Editable Word document</div>
                    <button id="export-docx-btn" class="ais-btn" style="width:100%;background:#1565c0;color:#fff;" onclick="exportAs('docx')">
                        Download DOCX
                    </button>
                </div>

                <div style="padding:16px;background:#fff;border:1px solid var(--border);border-radius:10px;text-align:center;">
                    <div style="font-size:1.6rem;margin-bottom:6px;">&#128203;</div>
                    <div style="font-size:.82rem;font-weight:600;color:var(--dark);margin-bottom:4px;">Plain Text</div>
                    <div style="font-size:.72rem;color:var(--muted);margin-bottom:10px;">Copy-paste friendly</div>
                    <button id="export-txt-btn" class="ais-btn" style="width:100%;background:#374151;color:#fff;" onclick="exportAs('txt')">
                        Download TXT
                    </button>
                </div>

                <div style="padding:16px;background:#fff;border:1px solid var(--border);border-radius:10px;text-align:center;">
                    <div style="font-size:1.6rem;margin-bottom:6px;">&#123; &#125;</div>
                    <div style="font-size:.82rem;font-weight:600;color:var(--dark);margin-bottom:4px;">JSON</div>
                    <div style="font-size:.72rem;color:var(--muted);margin-bottom:10px;">For developers / backup</div>
                    <button id="export-json-btn" class="ais-btn" style="width:100%;background:#0f766e;color:#fff;" onclick="exportAs('json')">
                        Download JSON
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/cv-builder.js"></script>
    <script src="~/js/ai-studio.js"></script>
    <script>
        var _cvRecordId = "@cvRecordId";
    </script>
}