@{
    ViewData["Title"] = "Career Intelligence Center";
    ViewData["Page"]  = "cic";
}

<style>
/* ══ Layout ══════════════════════════════════════════════════════ */
.ci-page { max-width: 1100px; margin: 0 auto; }

.ci-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
.ci-title  { font-size: 1.4rem; font-weight: 700; color: var(--dark); letter-spacing: -.02em; margin-bottom: .35rem; }
.ci-sub    { font-size: .92rem; color: var(--muted); }

/* ══ Steps ═══════════════════════════════════════════════════════ */
.ci-steps { display: flex; align-items: center; gap: 0; margin-bottom: 2rem; }
.ci-step  { display: flex; align-items: center; gap: .5rem; }
.ci-step-num {
    width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center;
    justify-content: center; font-size: .78rem; font-weight: 700; flex-shrink: 0;
    background: var(--border); color: var(--muted); transition: all .2s;
}
.ci-step-label { font-size: .85rem; font-weight: 500; color: var(--muted); white-space: nowrap; transition: color .2s; }
.ci-step.active .ci-step-num  { background: #1D4ED8; color: #fff; }
.ci-step.active .ci-step-label { color: var(--dark); }
.ci-step.done .ci-step-num    { background: var(--green); color: #fff; }
.ci-step.done .ci-step-label  { color: var(--green); }
.ci-step-line { flex: 1; height: 1px; background: var(--border); margin: 0 .6rem; min-width: 20px; }

/* ══ Panels ══════════════════════════════════════════════════════ */
.ci-panel {
    background: #fff; border: 1px solid var(--border); border-radius: 12px;
    padding: 1.5rem; margin-bottom: 1.25rem;
}
.ci-panel-title {
    font-size: 1rem; font-weight: 700; color: var(--dark); margin-bottom: 1.1rem;
    display: flex; align-items: center; gap: .5rem;
}
.ci-panel-title .ci-num {
    width: 22px; height: 22px; border-radius: 50%; background: #1D4ED8; color: #fff;
    font-size: .65rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

/* ══ Upload zone ═════════════════════════════════════════════════ */
.ci-upload-zone {
    border: 2px dashed var(--border); border-radius: 10px; padding: 2.5rem 1.5rem;
    text-align: center; cursor: pointer; transition: border-color .18s, background .18s;
    background: var(--surface);
}
.ci-upload-zone:hover, .ci-upload-zone.drag-over { border-color: #1D4ED8; background: #EFF6FF; }
.ci-upload-icon { font-size: 2.2rem; margin-bottom: .75rem; }
.ci-upload-headline { font-size: 1rem; font-weight: 600; color: var(--dark); margin-bottom: .35rem; }
.ci-upload-hint { font-size: .86rem; color: var(--muted); margin-bottom: 1rem; }
.ci-upload-types {
    display: flex; flex-wrap: wrap; gap: .35rem; justify-content: center;
}
.ci-upload-type {
    font-size: .75rem; font-weight: 600; padding: .22rem .65rem; border-radius: 4px;
    font-family: var(--mono); background: var(--surface); border: 1px solid var(--border); color: var(--muted);
}
.ci-upload-input { display: none; }

/* After upload: file info strip */
.ci-file-info {
    display: none; align-items: center; gap: .75rem; padding: .75rem 1rem;
    background: #F0FDF4; border: 1px solid #86efac; border-radius: 8px; margin-top: 1rem;
}
.ci-file-icon { font-size: 1.2rem; }
.ci-file-name { font-size: .9rem; font-weight: 600; color: #15803d; flex: 1; }
.ci-file-change {
    font-size: .72rem; color: var(--muted); text-decoration: none;
    border: 1px solid var(--border); border-radius: 4px; padding: .18rem .55rem;
    background: #fff; cursor: pointer;
}

/* Document type toggle */
.ci-doctype {
    display: flex; gap: .5rem; margin-top: 1rem;
}
.ci-doctype-btn {
    flex: 1; padding: .6rem; border: 1.5px solid var(--border); border-radius: 8px;
    background: var(--surface); font-size: .9rem; font-weight: 500; color: var(--muted);
    cursor: pointer; transition: all .15s; text-align: center; font-family: var(--sans);
}
.ci-doctype-btn.active { border-color: #1D4ED8; background: #EFF6FF; color: #1D4ED8; font-weight: 600; }

/* OCR Review */
.ci-ocr-box {
    display: none; margin-top: 1rem; padding: 1rem; background: #FEFCE8;
    border: 1px solid #fde68a; border-radius: 8px;
}
.ci-ocr-label { font-size: .76rem; font-weight: 600; color: #92400e; margin-bottom: .5rem; display: flex; align-items: center; gap: .35rem; }
.ci-ocr-textarea {
    width: 100%; height: 120px; padding: .5rem .65rem; background: #fff;
    border: 1px solid #fde68a; border-radius: 6px; font-size: .78rem;
    font-family: var(--mono); color: var(--dark); resize: vertical; outline: none; box-sizing: border-box;
}
.ci-ocr-actions { display: flex; gap: .5rem; margin-top: .6rem; align-items: center; }
.ci-ocr-apply { font-size: .74rem; font-weight: 600; padding: .32rem .85rem; background: #d97706; color: #fff; border: none; border-radius: 5px; cursor: pointer; font-family: var(--sans); }

/* ══ JD Panel ════════════════════════════════════════════════════ */
.ci-field { margin-bottom: .85rem; }
.ci-field label { display: block; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-family: var(--mono); margin-bottom: .28rem; }
.ci-field input, .ci-field textarea {
    width: 100%; padding: .5rem .75rem; background: var(--surface); border: 1px solid var(--border);
    border-radius: 7px; font-size: .9rem; color: var(--dark); font-family: var(--sans);
    outline: none; box-sizing: border-box; transition: border-color .15s;
}
.ci-field input:focus, .ci-field textarea:focus { border-color: #1D4ED8; background: #fff; }
.ci-field textarea { resize: vertical; line-height: 1.55; min-height: 110px; }
.ci-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
.ci-jd-note {
    font-size: .84rem; color: #1D4ED8; background: #EFF6FF; border: 1px solid #BFDBFE;
    border-radius: 6px; padding: .65rem .85rem; margin-bottom: .85rem;
    display: flex; align-items: flex-start; gap: .4rem; line-height: 1.55;
}
.ci-jd-skip { font-size: .74rem; color: var(--muted); cursor: pointer; text-decoration: underline; background: none; border: none; font-family: var(--sans); }

/* ══ Analysis cards ══════════════════════════════════════════════ */
.cic-wrap { padding: 0; }
.cic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: .85rem;
}
.cic-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: box-shadow .15s; }
.cic-card:hover { box-shadow: 0 2px 10px rgba(44,36,22,.07); }
.cic-card.locked { opacity: .5; pointer-events: none; }
.cic-card-head { display: flex; align-items: center; gap: .7rem; padding: .85rem 1rem; }
.cic-card-icon { width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .95rem; flex-shrink: 0; }
.cic-card-info { flex: 1; min-width: 0; }
.cic-card-name { font-size: .92rem; font-weight: 700; color: var(--dark); margin-bottom: .1rem; }
.cic-card-desc { font-size: .76rem; color: var(--muted); font-family: var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cic-card-score { font-size: .86rem; font-weight: 700; font-family: var(--mono); color: var(--muted); flex-shrink: 0; min-width: 34px; text-align: center; }
.cic-card-score.good { color: var(--green); }
.cic-card-score.warn { color: #d97706; }
.cic-card-score.bad  { color: var(--red); }
.cic-run-btn { flex-shrink: 0; padding: .42rem .95rem; background: var(--dark); color: var(--cream); border: none; border-radius: 7px; font-size: .8rem; font-weight: 600; cursor: pointer; font-family: var(--sans); transition: background .14s; white-space: nowrap; }
.cic-run-btn:hover:not(:disabled) { background: var(--charcoal); }
.cic-run-btn:disabled { opacity: .5; cursor: not-allowed; }

/* Shared CIC helpers */
.cic-sub-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--tan); font-family: var(--mono); margin: .75rem 0 .38rem; }
.cic-sub-label:first-child { margin-top: 0; }
.cic-tag { display: inline-flex; align-items: center; padding: 3px 11px; border-radius: 100px; font-size: .76rem; font-weight: 600; margin: 2px; }
.cic-tag.red   { background:#fef2f2;color:#dc2626;border:1px solid #fecaca; }
.cic-tag.green { background:#dcfce7;color:#15803d;border:1px solid #86efac; }
.cic-tag.amber { background:#fffbeb;color:#92400e;border:1px solid #fde68a; }
.cic-tag.blue  { background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe; }
.cic-item { display:flex;align-items:flex-start;gap:.45rem;margin-bottom:.35rem;font-size:.86rem;line-height:1.55; }
.cic-item-ic { flex-shrink:0;margin-top:.15rem;font-size:.78rem; }
.cic-copy-text {}

/* CIC Modal */
.cic-modal-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:2000;align-items:center;justify-content:center;padding:1rem; }
.cic-modal-box { background:#fff;border-radius:12px;max-width:680px;width:100%;max-height:82vh;overflow-y:auto;padding:0;box-shadow:0 20px 60px rgba(0,0,0,.22);position:relative; }
.cic-modal-header { display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem .85rem;border-bottom:1px solid var(--border);position:sticky;top:0;background:#fff;z-index:1;border-radius:12px 12px 0 0; }
.cic-modal-title { font-size:1.05rem;font-weight:700;color:var(--dark);letter-spacing:-.01em; }
.cic-modal-close { width:30px;height:30px;border:none;background:none;cursor:pointer;border-radius:6px;font-size:.9rem;color:var(--muted);display:flex;align-items:center;justify-content:center;transition:background .12s,color .12s;flex-shrink:0; }
.cic-modal-close:hover { background:var(--surface);color:var(--dark); }
.cic-modal-body { padding:1.25rem 1.4rem 1.6rem;font-size:.9rem; }

/* Lock overlay */
.ci-locked-overlay {
    display: none; position: fixed; inset: 0; background: rgba(255,255,255,.8);
    z-index: 100; align-items: center; justify-content: center; flex-direction: column; gap: .75rem;
}
.ci-locked-overlay.visible { display: flex; }
.ci-locked-msg { font-size: .9rem; color: var(--muted); text-align: center; }

/* Buttons */
.ci-btn-primary {
    display: inline-flex; align-items: center; gap: .4rem; padding: .6rem 1.5rem;
    background: #1D4ED8; color: #fff; border: none; border-radius: 8px;
    font-size: .9rem; font-weight: 600; cursor: pointer; font-family: var(--sans);
    transition: background .15s;
}
.ci-btn-primary:hover { background: #1e40af; }
.ci-btn-primary:disabled { opacity: .5; cursor: not-allowed; }
.ci-btn-ghost {
    display: inline-flex; align-items: center; gap: .35rem; padding: .5rem 1rem;
    background: none; color: var(--muted); border: 1px solid var(--border); border-radius: 8px;
    font-size: .8rem; font-weight: 500; cursor: pointer; font-family: var(--sans);
}
.ci-btn-ghost:hover { border-color: var(--tan); color: var(--dark); }

/* Header score pills */
.cic-score-pill { display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .85rem;border-radius:100px;border:1px solid var(--border);background:#fff;font-size:.78rem;font-family:var(--mono); }
.cic-score-pill .sp-label { color:var(--muted); }
.cic-score-pill .sp-value { font-weight:700;color:var(--dark); }
.cic-score-pill.good .sp-value { color:var(--green); }
.cic-score-pill.warn .sp-value { color:#d97706; }
.cic-score-pill.bad  .sp-value { color:var(--red); }

@@media (max-width: 700px) {
    .ci-row { grid-template-columns: 1fr; }
    .cic-grid { grid-template-columns: 1fr; }
}
</style>

<div class="ci-page">

    <!-- Header -->
    <div class="ci-header">
        <div class="ci-title">&#127919; Career Intelligence Center</div>
        <div class="ci-sub">Upload your CV or Cover Letter, describe the job, and get detailed AI-powered analysis.</div>
    </div>

    <!-- Step indicator -->
    <div class="ci-steps" id="ciSteps">
        <div class="ci-step active" id="step-ind-1">
            <div class="ci-step-num">1</div>
            <span class="ci-step-label">Upload Document</span>
        </div>
        <div class="ci-step-line"></div>
        <div class="ci-step" id="step-ind-2">
            <div class="ci-step-num">2</div>
            <span class="ci-step-label">Job Description</span>
        </div>
        <div class="ci-step-line"></div>
        <div class="ci-step" id="step-ind-3">
            <div class="ci-step-num">3</div>
            <span class="ci-step-label">Run Analysis</span>
        </div>
    </div>

    <!-- ── STEP 1: UPLOAD ── -->
    <div class="ci-panel" id="ciStep1">
        <div class="ci-panel-title"><span class="ci-num">1</span> Upload Your Document</div>

        <!-- Document type toggle -->
        <div class="ci-doctype" style="margin-bottom:1.1rem;">
            <button class="ci-doctype-btn active" id="dtCV" onclick="ciSetDocType('CV')">&#128196; CV / Resume</button>
            <button class="ci-doctype-btn" id="dtCL" onclick="ciSetDocType('CoverLetter')">&#9993; Cover Letter</button>
        </div>

        <!-- Upload zone -->
        <div class="ci-upload-zone" id="ciUploadZone"
             onclick="document.getElementById('ciFileInput').click()"
             ondragover="event.preventDefault();this.classList.add('drag-over')"
             ondragleave="this.classList.remove('drag-over')"
             ondrop="ciHandleDrop(event)">
            <div class="ci-upload-icon">&#128228;</div>
            <div class="ci-upload-headline">Drop your file here or click to browse</div>
            <div class="ci-upload-hint">Supported formats:</div>
            <div class="ci-upload-types">
                <span class="ci-upload-type">PDF</span>
                <span class="ci-upload-type">DOCX</span>
                <span class="ci-upload-type">TXT</span>
                <span class="ci-upload-type">PNG</span>
                <span class="ci-upload-type">JPG</span>
                <span class="ci-upload-type">JPEG</span>
                <span class="ci-upload-type">WEBP</span>
            </div>
            <input type="file" id="ciFileInput" class="ci-upload-input"
                   accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.webp"
                   onchange="ciHandleFile(this.files[0])" />
        </div>

        <!-- File info strip (shown after upload) -->
        <div class="ci-file-info" id="ciFileInfo">
            <span class="ci-file-icon" id="ciFileIcon">&#128196;</span>
            <span class="ci-file-name" id="ciFileName">document.pdf</span>
            <span id="ciFileStatus" style="font-size:.72rem;color:var(--green);font-family:var(--mono);">✓ Ready</span>
            <button class="ci-file-change" onclick="ciReset()">Change file</button>
        </div>

        <!-- OCR review (shown for images) -->
        <div class="ci-ocr-box" id="ciOcrBox">
            <div class="ci-ocr-label">&#128247; AI extracted the following text — review and edit if needed before analysis</div>
            <textarea class="ci-ocr-textarea" id="ciOcrText" placeholder="Extracted text will appear here…"></textarea>
            <div class="ci-ocr-actions">
                <button class="ci-ocr-apply" onclick="ciApplyOcr()">Use this text for analysis</button>
                <span style="font-size:.72rem;color:#92400e;font-family:var(--mono);">&#9888; Review OCR output carefully for accuracy</span>
            </div>
        </div>

        <!-- Continue button -->
        <div style="display:flex;justify-content:flex-end;margin-top:1.1rem;">
            <button class="ci-btn-primary" id="ciStep1Btn" disabled onclick="ciGoStep2()">
                Continue &rarr;
            </button>
        </div>
    </div>

    <!-- ── STEP 2: JOB DESCRIPTION ── -->
    <div class="ci-panel" id="ciStep2" style="display:none;">
        <div class="ci-panel-title"><span class="ci-num">2</span> Job Description <span style="font-size:.72rem;font-weight:400;color:var(--muted);margin-left:.3rem;">(recommended for accurate analysis)</span></div>

        <div class="ci-jd-note">
            &#128161; For ATS scoring and job matching to work accurately, paste the full job description.
            Without it, only general feedback is available.
        </div>

        <div class="ci-row">
            <div class="ci-field">
                <label>Job Title *</label>
                <input type="text" id="ciJdTitle" placeholder="e.g. Software Engineer" />
            </div>
            <div class="ci-field">
                <label>Company <span style="font-weight:400;text-transform:none;">(optional)</span></label>
                <input type="text" id="ciJdCompany" placeholder="e.g. Google" />
            </div>
        </div>
        <div class="ci-field">
            <label>Full Job Description *</label>
            <textarea id="ciJdText" rows="6" placeholder="Paste the complete job description here — the more detail, the more accurate your analysis will be."></textarea>
        </div>

        <div style="display:flex;align-items:center;gap:1rem;justify-content:flex-end;margin-top:.25rem;">
            <button class="ci-btn-ghost" onclick="ciGoStep1()">&larr; Back</button>
            <button class="ci-btn-ghost" onclick="ciGoStep3(true)">Skip (General analysis only)</button>
            <button class="ci-btn-primary" onclick="ciGoStep3(false)">Start Analysis &rarr;</button>
        </div>
    </div>

    <!-- ── STEP 3: ANALYSIS CARDS ── -->
    <div id="ciStep3" style="display:none;">

        <!-- Summary bar -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:1.25rem;">
            <div>
                <div style="font-size:.9rem;font-weight:700;color:var(--dark);">Analysis Tools</div>
                <div style="font-size:.76rem;color:var(--muted);" id="ciSummaryLine">Click any tool to run analysis.</div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;" id="ciScorePills">
                <div class="cic-score-pill" id="cic-score-ats"><span class="sp-label">ATS</span><span class="sp-value" id="cic-val-ats">—</span></div>
                <div class="cic-score-pill" id="cic-score-job"><span class="sp-label">Job Match</span><span class="sp-value" id="cic-val-job">—</span></div>
                <div class="cic-score-pill" id="cic-score-health"><span class="sp-label">Health</span><span class="sp-value" id="cic-val-health">—</span></div>
                <button class="ci-btn-ghost" style="font-size:.72rem;padding:.3rem .7rem;" onclick="ciGoStep2()">&larr; Change JD</button>
            </div>
        </div>

        <div class="cic-grid">
            <!-- ATS -->
            <div class="cic-card" id="card-ats">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#fef2f2;">&#127919;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">ATS Analysis</div>
                        <div class="cic-card-desc">Keyword match · Missing keywords · Formatting</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-ats">—</span>
                    <button class="cic-run-btn" id="cic-btn-ats" onclick="cicRun('ats')">Analyze</button>
                </div>
            </div>
            <!-- Job Match -->
            <div class="cic-card" id="card-job">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#eff6ff;">&#128269;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">Job Match Analysis</div>
                        <div class="cic-card-desc">Skills match · Missing skills · Role fit</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-job">—</span>
                    <button class="cic-run-btn" id="cic-btn-job" onclick="cicRun('job')">Analyze</button>
                </div>
            </div>
            <!-- CV Health -->
            <div class="cic-card" id="card-health">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#f0fdf4;">&#9989;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">CV Health Report</div>
                        <div class="cic-card-desc">Completeness · Readability · Bullet quality</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-health">—</span>
                    <button class="cic-run-btn" id="cic-btn-health" onclick="cicRun('health')">Analyze</button>
                </div>
            </div>
            <!-- Recruiter -->
            <div class="cic-card" id="card-recruiter">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#faf5ff;">&#128101;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">Recruiter Review</div>
                        <div class="cic-card-desc">Shortlist reasons · Red flags · Evidence</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-rec">—</span>
                    <button class="cic-run-btn" id="cic-btn-rec" onclick="cicRun('recruiter')">Analyze</button>
                </div>
            </div>
            <!-- Interview -->
            <div class="cic-card" id="card-interview">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#f0fdf4;">&#127908;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">Interview Preparation</div>
                        <div class="cic-card-desc">Technical · Behavioral · Project questions</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-iq"></span>
                    <button class="cic-run-btn" id="cic-btn-iq" onclick="cicRun('interview')">Generate</button>
                </div>
            </div>
            <!-- LinkedIn -->
            <div class="cic-card" id="card-linkedin">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#eff6ff;">&#128279;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">LinkedIn Generator</div>
                        <div class="cic-card-desc">Headline · About section · Experience rewrites</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-li"></span>
                    <button class="cic-run-btn" id="cic-btn-li" onclick="cicRun('linkedin')">Generate</button>
                </div>
            </div>
            <!-- Cover Letter Review -->
            <div class="cic-card" id="card-clreview">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#F5F3FF;">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <rect x="1.5" y="1.5" width="13" height="13" rx="2" stroke="#5E6AD2" stroke-width="1.3"/>
                            <path d="M4 5.5h8M4 8h6M4 10.5h4" stroke="#5E6AD2" stroke-width="1.3" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">Cover Letter Review</div>
                        <div class="cic-card-desc">Tone · Personalization · Keywords · Clarity</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-cl-review">—</span>
                    <button class="cic-run-btn" id="cic-btn-cl-review" onclick="cicReviewCoverLetterSA()">Review</button>
                </div>
            </div>
            <!-- Optimizer -->
            <div class="cic-card" id="card-optimizer">
                <div class="cic-card-head">
                    <div class="cic-card-icon" style="background:#fefce8;">&#10024;</div>
                    <div class="cic-card-info">
                        <div class="cic-card-name">Resume Optimizer</div>
                        <div class="cic-card-desc">Improvements · Weak sections · Keywords</div>
                    </div>
                    <span class="cic-card-score" id="cic-s-opt"></span>
                    <button class="cic-run-btn" id="cic-btn-opt" onclick="cicRun('optimizer')">Optimize</button>
                </div>
            </div>
        </div>
    </div>

</div><!-- /ci-page -->

<!-- Modal (same as CIC) -->
<div id="cicModal" class="cic-modal-overlay" onclick="cicCloseModal(event)">
    <div class="cic-modal-box" onclick="event.stopPropagation()">
        <div class="cic-modal-header">
            <span class="cic-modal-title" id="cicModalTitle"></span>
            <button class="cic-modal-close" onclick="cicForceClose()" title="Close">&#10005;</button>
        </div>
        <div class="cic-modal-body" id="cicModalBody"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" crossorigin="anonymous"></script>

    <script>
    // ── Stubs for CV Builder globals not present on this page ─────
    var _cv = null;
    var _accentColor = "#1a1a2e";
    function switchWorkspace() {}
    function exportAsPdf() {}
    function exportAsPng() {}
    function downloadAsWord() {}

    // ── Page state ────────────────────────────────────────────────
    var _ciDocType  = "CV";      // "CV" | "CoverLetter"
    var _ciReady    = false;     // text has been extracted and confirmed

    // Force uploaded-source mode for this standalone page
    document.addEventListener("DOMContentLoaded", function() {
        _cicSource = "uploaded";
    });

    // ── Document type ─────────────────────────────────────────────
    function ciSetDocType(type) {
        _ciDocType = type;
        document.getElementById("dtCV").classList.toggle("active", type === "CV");
        document.getElementById("dtCL").classList.toggle("active", type === "CoverLetter");
    }

    // ── File handling ─────────────────────────────────────────────
    function ciHandleDrop(e) {
        e.preventDefault();
        document.getElementById("ciUploadZone").classList.remove("drag-over");
        var file = e.dataTransfer.files[0];
        if (file) ciHandleFile(file);
    }

    function ciHandleFile(file) {
        if (!file) return;
        var ext = (file.name.split(".").pop() || "").toLowerCase();
        var isImage = ["png","jpg","jpeg","webp"].includes(ext);
        var isDoc   = ["pdf","docx","txt"].includes(ext);
        if (!isImage && !isDoc) {
            alert("Unsupported file type. Please use PDF, DOCX, TXT, PNG, JPG, JPEG, or WEBP.");
            return;
        }

        ciShowFileInfo(file.name, isImage ? "&#128247;" : "&#128196;", "Extracting…");
        document.getElementById("ciStep1Btn").disabled = true;
        _ciReady = false;
        _cicUploadedText = null;
        _cicUploadCache  = null;

        if (ext === "txt") {
            var reader = new FileReader();
            reader.onload = function(e) {
                _cicUploadedText = (e.target.result || "").trim();
                _ciReady = true;
                ciShowFileInfo(file.name, "&#128196;", "✓ Ready");
                document.getElementById("ciStep1Btn").disabled = false;
                document.getElementById("ciOcrBox").style.display = "none";
            };
            reader.readAsText(file);
        } else {
            var fd = new FormData();
            fd.append("file", file);
            fetch("/api/cv/extract", { method: "POST", body: fd })
            .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
            .then(function(r) {
                if (!r.ok) throw new Error(r.data.message || "Extraction failed.");
                _cicUploadedFormData = r.data.formData;
                var extracted = cicFormDataToText(r.data.formData);

                if (isImage) {
                    // Show OCR review before confirming
                    document.getElementById("ciOcrText").value = extracted;
                    document.getElementById("ciOcrBox").style.display = "block";
                    ciShowFileInfo(file.name, "&#128247;", "Review text below");
                    // User must click Apply before continuing
                } else {
                    _cicUploadedText = extracted;
                    _ciReady = true;
                    ciShowFileInfo(file.name, "&#128196;", "✓ Ready");
                    document.getElementById("ciStep1Btn").disabled = false;
                    document.getElementById("ciOcrBox").style.display = "none";
                }
            })
            .catch(function(e) {
                ciShowFileInfo(file.name, "&#10060;", "✗ " + e.message);
            });
        }
    }

    function ciApplyOcr() {
        var text = document.getElementById("ciOcrText").value.trim();
        if (!text) { alert("Extracted text is empty. Please upload a clearer image."); return; }
        _cicUploadedText = text;
        _ciReady = true;
        document.getElementById("ciOcrBox").style.display = "none";
        document.getElementById("ciFileStatus").textContent = "✓ Ready";
        document.getElementById("ciStep1Btn").disabled = false;
    }

    function ciShowFileInfo(name, icon, status) {
        document.getElementById("ciFileInfo").style.display = "flex";
        document.getElementById("ciFileName").textContent = name;
        document.getElementById("ciFileIcon").innerHTML = icon;
        document.getElementById("ciFileStatus").textContent = status;
    }

    function ciReset() {
        _cicUploadedText = null;
        _cicUploadedFormData = null;
        _cicUploadCache = null;
        _ciReady = false;
        document.getElementById("ciFileInfo").style.display = "none";
        document.getElementById("ciOcrBox").style.display = "none";
        document.getElementById("ciStep1Btn").disabled = true;
        document.getElementById("ciFileInput").value = "";
    }

    // ── Step navigation ───────────────────────────────────────────
    function ciMarkStep(n) {
        for (var i = 1; i <= 3; i++) {
            var el = document.getElementById("step-ind-" + i);
            if (!el) continue;
            el.className = "ci-step" + (i < n ? " done" : i === n ? " active" : "");
        }
    }

    function ciGoStep1() {
        document.getElementById("ciStep1").style.display = "block";
        document.getElementById("ciStep2").style.display = "none";
        document.getElementById("ciStep3").style.display = "none";
        ciMarkStep(1);
    }

    function ciGoStep2() {
        if (!_ciReady || !_cicUploadedText) {
            alert("Please upload and confirm your document first.");
            return;
        }
        document.getElementById("ciStep1").style.display = "none";
        document.getElementById("ciStep2").style.display = "block";
        document.getElementById("ciStep3").style.display = "none";
        ciMarkStep(2);
    }

    function ciGoStep3(skipJd) {
        if (!_ciReady || !_cicUploadedText) {
            alert("Please upload your document first.");
            ciGoStep1(); return;
        }

        // Sync JD state to the global CIC variables
        var titleEl = document.getElementById("ciJdTitle");
        var textEl  = document.getElementById("ciJdText");
        _cicJobTitle       = titleEl ? titleEl.value.trim() : "";
        _cicJobDescription = textEl  ? textEl.value.trim()  : "";

        // Sync to the existing JD fields used by career-intelligence.js
        var cicTitle = document.getElementById("cicJdTitle");
        var cicText  = document.getElementById("cicJdText");
        if (cicTitle) cicTitle.value = _cicJobTitle;
        if (cicText)  cicText.value  = _cicJobDescription;

        if (!skipJd && !_cicJobDescription) {
            if (!confirm("No job description provided.\n\nYou'll get general feedback only — ATS match and Job Match scores won't be accurate.\n\nContinue anyway?"))
                return;
        }

        // Update summary line
        var summary = "Analyzing: " + _ciDocType.replace("CoverLetter","Cover Letter");
        if (_cicJobTitle) summary += " · Target: " + _cicJobTitle;
        if (!_cicJobDescription) summary += " · ⚠ No JD (general analysis only)";
        document.getElementById("ciSummaryLine").textContent = summary;

        // ── Show / hide cards based on document type ──────────────
        // CV: all CV tools visible, Cover Letter Review hidden
        // CL: Cover Letter Review visible, CV-specific tools hidden
        var cvOnlyCards = ["card-health", "card-interview", "card-linkedin", "card-optimizer"];
        var clOnlyCards = ["card-clreview"];

        if (_ciDocType === "CV") {
            cvOnlyCards.forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.style.display = "";
            });
            clOnlyCards.forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.style.display = "none";
            });
            // Update health score pill label
            var healthPill = document.getElementById("cic-score-health");
            if (healthPill) healthPill.style.display = "";
        } else {
            // Cover Letter mode
            cvOnlyCards.forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.style.display = "none";
            });
            clOnlyCards.forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.style.display = "";
            });
            // Hide CV Health pill from score bar (not relevant for CL)
            var healthPill = document.getElementById("cic-score-health");
            if (healthPill) healthPill.style.display = "none";
            // Update CL review button label
            var clBtn = document.getElementById("cic-btn-cl-review");
            if (clBtn && clBtn.textContent.trim() === "Review") {
                clBtn.style.background = "#5E6AD2"; // accent to draw attention
            }
        }

        // Prepend document type label to uploaded text so AI knows what it's analyzing
        if (_cicUploadedText && !_cicUploadedText.startsWith("[Document Type:")) {
            var docLabel = _ciDocType === "CoverLetter" ? "Cover Letter" : "CV/Resume";
            _cicUploadedText = "[Document Type: " + docLabel + "]\n\n" + _cicUploadedText;
        }

        document.getElementById("ciStep1").style.display = "none";
        document.getElementById("ciStep2").style.display = "none";
        document.getElementById("ciStep3").style.display = "block";
        ciMarkStep(3);

        // Reset all previous results / caches
        _cicAnalysisCache = null;
        _cicUploadCache   = null;
        _cicResults       = {};
        _cicResultVersions= {};
        _cicSource        = "uploaded";
    }

    // ── Cover Letter Review for standalone page ───────────────────
    function cicReviewCoverLetterSA() {
        // Use the uploaded text directly as the letter
        if (!_cicUploadedText) {
            cicOpenModal("Cover Letter Review",
                '<div style="padding:16px 4px;font-size:.82rem;color:var(--muted);">No document uploaded yet.</div>');
            return;
        }
        var btn = document.getElementById("cic-btn-cl-review");
        if (btn) { btn.disabled = true; btn.textContent = "..."; }
        cicOpenModal("Cover Letter Review", cicLoadingHtml());

        fetch("/api/ai-studio/analyze-cover-letter", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                letterText:     _cicUploadedText,
                jobDescription: _cicJobDescription || "",
                companyName:    document.getElementById("ciJdCompany") ? document.getElementById("ciJdCompany").value : ""
            })
        })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(r) {
            if (!r.ok) throw new Error(r.data.message || "Review failed.");
            var d = r.data;
            var metrics = [["Overall",d.overallScore],["Tone",d.toneScore],["Keywords",d.keywordScore],["Clarity",d.clarityScore]];
            var html = '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:12px;">';
            metrics.forEach(function(m) {
                var n = m[1]||0; var c = n>=80?"#15803d":n>=60?"#d97706":"#dc2626";
                html += '<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 4px;text-align:center;">' +
                    '<div style="font-size:1.4rem;font-weight:800;color:'+c+';">'+n+'</div>' +
                    '<div style="font-size:.65rem;color:var(--muted);font-family:var(--mono);">'+cicEsc(m[0])+'</div></div>';
            });
            html += '</div>';
            if (d.toneSummary) html += '<div style="font-size:.82rem;color:var(--muted);font-style:italic;margin-bottom:10px;padding:9px 11px;background:var(--surface);border-radius:6px;border:1px solid var(--border);">'+cicEsc(d.toneSummary)+'</div>';
            if (d.strengths && d.strengths.length) {
                html += '<div class="cic-sub-label">Strengths</div>';
                d.strengths.forEach(function(s){html+='<div class="cic-item"><span class="cic-item-ic" style="color:#15803d;">&#10003;</span><span>'+cicEsc(s)+'</span></div>';});
            }
            if (d.improvements && d.improvements.length) {
                html += '<div class="cic-sub-label">Improvements</div>';
                d.improvements.forEach(function(s){html+='<div class="cic-item"><span class="cic-item-ic">&#128161;</span><span>'+cicEsc(s)+'</span></div>';});
            }
            if (d.missingKeywords && d.missingKeywords.length) {
                html += '<div class="cic-sub-label">Consider Adding</div><div style="display:flex;flex-wrap:wrap;gap:4px;">';
                d.missingKeywords.forEach(function(k){html+='<span class="cic-tag amber">'+cicEsc(k)+'</span>';});
                html += '</div>';
            }
            // cicStoreResult appends the Save Report button once — don't add it here
            cicStoreResult("clreview", html, d.overallScore);
            // Reopen modal with the stored version (which includes the Save button)
            cicOpenModal("Cover Letter Review", _cicResults["clreview"]);
            if (btn) btn.disabled = false;
        })
        .catch(function(e) {
            cicRestoreBtn("clreview", "Review");
            cicOpenModal("Cover Letter Review", cicErrorHtml(e.message));
        });
    }
    </script>
    <script src="~/js/career-intelligence.js" asp-append-version="true"></script>
}
